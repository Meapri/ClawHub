<Application x:Class="ClawApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClawApp.ViewModels"
             xmlns:v="clr-namespace:ClawApp.Views"
             xmlns:local="clr-namespace:ClawApp"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibility x:Key="Vis"/>
            <local:BoolToVisibility x:Key="NotVis" Invert="True"/>
            <local:NullToVisibility x:Key="NullVis"/>

            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><v:LibraryView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameViewModel}"><v:GameView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MappingEditorViewModel}"><v:MappingEditorView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><v:ProfilesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>

            <!-- 게임 커버 타일 (라이브러리/홈 공용) -->
            <DataTemplate x:Key="CoverTile" DataType="{x:Type vm:GameTileViewModel}">
                <Button Style="{StaticResource TileButton}" Command="{Binding OpenCommand}" Width="168" Height="252">
                    <Grid ClipToBounds="True">
                        <Border CornerRadius="8" Background="{Binding Placeholder}"/>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding HasCover, Converter={StaticResource NotVis}}" Margin="12">
                            <Image Source="{Binding Icon}" Width="56" Height="56" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                        <Border CornerRadius="8" Visibility="{Binding HasCover, Converter={StaticResource Vis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
