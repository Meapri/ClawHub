<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClawCore\ClawCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ClawHub.ico" />
    <!-- Pretendard (SIL OFL 1.1) — 한글·영문을 한 폰트로 (Segoe UI + 맑은 고딕 섞임 방지) -->
    <Resource Include="Fonts\*.otf" />
    <!-- Lucide 아이콘 글꼴 (ISC) · 패드 버튼 그림 (Kenney Input Prompts, CC0) -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\Input\*.png" />
    <!-- Xbox 모드 홈 앱 등록(외부 위치 패키지)이 앱 폴더의 로고를 참조 -->
    <None Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ClawHub.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
