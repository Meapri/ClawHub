<Window x:Class="ClawApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ClawApp.Views"
        xmlns:m="clr-namespace:ClawApp.Motion"
        xmlns:local="clr-namespace:ClawApp"
        Title="ClawHub" Icon="Assets/ClawHub.ico"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}" FontSize="16" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False">
    <!--
      AllowsTransparency(레이어드 창)는 쓰지 않는다: ClearType이 꺼지고 글자가 뭉개진다.
      셸 화면은 흐린 게임 아트(Backdrop)가 창 전체를 덮고, 게임 위 오버레이일 때는 DWM Acrylic이 뒤 게임을 흐린다.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 터치용 뒤로 버튼 (제목 왼쪽). 패드는 B가 있으므로 포커스를 받지 않는다. 손가락 크기 52×52 -->
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="m:Press.Scale" Value="0.9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{DynamicResource TileFill}" Opacity="0"/>
                            <Border x:Name="Down" Background="{DynamicResource TileFillHover}" Opacity="0"/>
                            <TextBlock Text="{StaticResource Icon.ArrowLeft}" FontFamily="{StaticResource LucideFont}" FontSize="30"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Down" Property="Opacity" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 하단 힌트 = 누르면 그 패드 버튼과 같은 동작 (터치·마우스). 패드 포커스는 받지 않는다 -->
        <Style x:Key="HintButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="m:Press.Scale" Value="0.96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" Background="{DynamicResource TileFill}" Opacity="0"/>
                            <Border x:Name="Down" Background="{DynamicResource TileFillHover}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Down" Property="Opacity" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 확인 대화 상자 버튼: 확인 = 강조색(위험하면 빨강), 취소 = 테두리 버튼 -->
        <Style x:Key="DialogConfirm" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Danger}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
                    <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DialogCancel" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="27,11"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
            <Setter Property="m:Press.Scale" Value="0.95"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ── 셸 화면 ─────────────────────────────────────── -->
        <!-- 패널이 열려 있는 동안 흐린 셸을 비트맵 한 장으로 캐시한다: 패널이 미끄러져 들어오거나 값이 갱신될 때
             화면 전체(2880×1800) 흐림을 프레임마다 다시 계산하지 않는다. 흐림은 아래 Shell의 Effect가 그대로 그린다 -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnyPanelOpen}" Value="True">
                            <Setter Property="CacheMode">
                                <Setter.Value><BitmapCache RenderAtScale="1" SnapsToDevicePixels="True"/></Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        <Grid x:Name="Shell" Visibility="{Binding IsShellVisible, Converter={StaticResource Vis}}">
            <!-- 패널이 열리면 뒤 화면을 흐리게 (앱 안의 Acrylic) -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnyPanelOpen}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value><BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance"/></Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="104"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 배경: 지금 고른 게임의 아트를 크게 흐리고 어둡게 (두 층을 교차 페이드).
                 흐림은 층마다 BitmapCache(반 해상도)에 한 번만 그려진다 — 글자가 없는 층이라 화질 손해 없음 -->
            <Grid Grid.RowSpan="3" Background="{DynamicResource BackdropFallback}" ClipToBounds="True" IsHitTestVisible="False"
                  m:Backdrop.IsHost="True" m:Backdrop.Default="{Binding BackdropDefault}">
                <Grid Margin="-120" Opacity="0">
                    <Grid.CacheMode><BitmapCache RenderAtScale="0.5"/></Grid.CacheMode>
                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.Effect><BlurEffect Radius="{Binding BackdropBlur}" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
                    </Image>
                </Grid>
                <Grid Margin="-120" Opacity="0">
                    <Grid.CacheMode><BitmapCache RenderAtScale="0.5"/></Grid.CacheMode>
                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.Effect><BlurEffect Radius="{Binding BackdropBlur}" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
                    </Image>
                </Grid>
                <Rectangle Fill="{DynamicResource BackdropTintSolid}" Opacity="{Binding BackdropDim}"/>
                <Rectangle Fill="{DynamicResource BackdropShade}"/>
            </Grid>

            <!-- 상단: 피벗 제목 + 상태 -->
            <Grid Margin="48,14,40,0">
                <!-- 긴 제목은 상태 표시줄 앞에서 말줄임 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 상태 표시줄: 실행 중 게임 · 성능 · 온도 · 컨트롤러 · 네트워크 · 볼륨 · 배터리 · 시계. 누르면 그 항목의 패널이 열린다 (터치·마우스) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Button Style="{StaticResource StatusButton}" Command="{Binding RunningTile.OpenCommand}" ToolTip="실행 중인 게임"
                            Visibility="{Binding RunningGame, Converter={StaticResource NullVis}}" Background="{DynamicResource Accent}" MaxWidth="260">
                        <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource AccentText}">
                            <TextBlock Text="{StaticResource Icon.Play}" Style="{StaticResource StatusIcon}" FontSize="19" Foreground="{DynamicResource AccentText}"/>
                            <TextBlock Text="{Binding RunningGame.Title}" Style="{StaticResource StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="service" ToolTip="ClawHub 서비스 연결 안 됨"
                            Visibility="{Binding ServiceConnected, Converter={StaticResource NotVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.TriangleAlert}" Style="{StaticResource StatusIcon}" Foreground="{DynamicResource Warn}"/>
                            <TextBlock Text="서비스 꺼짐" Style="{StaticResource StatusText}" Foreground="{DynamicResource Warn}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="perf" ToolTip="성능 모드"
                            Visibility="{Binding PerfText, Converter={StaticResource NullVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PerfIcon}" Style="{StaticResource StatusIcon}"/>
                            <TextBlock Text="{Binding PerfText}" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="system" ToolTip="시스템 상태"
                            Visibility="{Binding CpuTempText, Converter={StaticResource NullVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Thermometer}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CpuHot}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource StatusText}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="controller" ToolTip="컨트롤러"
                            Visibility="{Binding ControllerConnected, Converter={StaticResource Vis}}">
                        <TextBlock Text="{StaticResource Icon.Gamepad2}" Style="{StaticResource StatusIcon}"/>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="network" ToolTip="{Binding NetworkText}">
                        <TextBlock Text="{Binding NetworkIcon}" Style="{StaticResource StatusIcon}"/>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="sound" ToolTip="밝기·소리"
                            Visibility="{Binding VolumeText, Converter={StaticResource NullVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding VolumeIcon}" Style="{StaticResource StatusIcon}"/>
                            <TextBlock Text="{Binding VolumeText}" Style="{StaticResource StatusText}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="battery" ToolTip="배터리">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BatteryIcon}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BatteryLow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource StatusText}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <!-- 구분선 뒤 시계: 같은 18px, 굵기만 다르게 -->
                    <Border Width="1" Height="24" Background="{DynamicResource StrokeStrong}" Opacity="0.5" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="clock" ToolTip="날짜·시간">
                        <TextBlock Text="{Binding Clock}" Style="{StaticResource StatusText}" FontWeight="Bold" Margin="0"/>
                    </Button>
                    <!-- 터치용 빠른 설정 (패드는 QS 버튼) -->
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenQuickSettingsCommand}" ToolTip="빠른 설정">
                        <TextBlock Text="{StaticResource Icon.SlidersHorizontal}" Style="{StaticResource StatusIcon}"/>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,24,0">
                    <TextBlock Text="CLAWHUB" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="1,0,0,0"/>
                    <!-- 큰 제목. 홈이 아닌 페이지는 왼쪽에 터치용 뒤로 버튼 (패드 B와 같은 경로, 패드 포커스는 받지 않음) -->
                    <DockPanel x:Name="PivotHeader" Margin="-2,-4,0,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource BackButton}" Click="BackButton_Click" ToolTip="뒤로"
                                Uid="CaptureBypass" VerticalAlignment="Center" Margin="-10,4,6,0"
                                Visibility="{Binding ShowBackButton, Converter={StaticResource Vis}}"/>
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PivotTitle}"/>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- 페이지 -->
            <!-- 자주 가는 페이지는 화면을 다시 만들지 않고 숨겨 두었다가 쓴다 (Views/PageHost.cs) -->
            <v:PageHost x:Name="PageHost" Grid.Row="1" Page="{Binding CurrentPage}" Focusable="False"
                            PreviewGotKeyboardFocus="PageHost_GotKeyboardFocus"/>

            <!-- 하단 버튼 힌트: 누르면 그 패드 버튼과 같은 동작 (항목 안쪽 여백 12 → 오른쪽 여백 28 + 12 = 40) -->
            <!-- 힌트가 바뀌면(페이지·패널) 짧게 차례로 들어온다. 같은 힌트면 목록을 바꾸지 않으므로 다시 움직이지 않는다 -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Hints}" HorizontalAlignment="Right" Margin="0,0,28,0" Focusable="False" Uid="CaptureBypass"
                          m:Entrance.Stagger="Items" m:Entrance.Offset="16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource HintButton}" Click="HintButton_Click">
                            <!-- 패드 버튼 그림 (A/B/X/Y는 Xbox 색 그대로, LB·RB·☰·… 는 글자색 실루엣) -->
                            <StackPanel Orientation="Horizontal">
                                <v:ButtonGlyph Key="{Binding Glyph}" Width="28" Height="28" Margin="0,0,8,0"/>
                                <!-- 흐린 배경 위에서도 읽히게: 굵게 + 본문 글자색 -->
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        </Grid>

        <!-- 아래 층들은 Visibility 대신 m:Reveal.IsShown으로 켜고 끈다: 닫힐 때 짧게 사라진 뒤 접힌다 (Motion/Reveal.cs).
             닫히는 동안 글자가 비지 않게 내용은 …Shown(마지막 내용)을 본다 (ShellViewModel.Shown.cs) -->

        <!-- ── 패널 뒤 어둡게 ─────────────────────────────── -->
        <Border Background="{DynamicResource Scrim}" m:Reveal.IsShown="{Binding IsAnyPanelOpen}" MouseDown="Scrim_MouseDown"/>

        <!-- ── 상태 표시줄 항목 패널 (표시줄 바로 아래 오른쪽). 다른 항목으로 바로 바꾸면 내용이 다시 미끄러져 들어온다 ── -->
        <v:StatusFlyout x:Name="StatusFlyout" Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,40,0"
                        m:Entrance.Stagger="Self" m:Entrance.Offset="24" m:Entrance.Key="{Binding StatusPanel}"
                        m:Reveal.IsShown="{Binding StatusPanel, Converter={x:Static local:HasValue.Instance}}" m:Reveal.ExitY="-12"/>

        <!-- ── 빠른 설정 (오른쪽 가장자리에서 미끄러져 나오는 참 바, 닫히면 그쪽으로 되돌아간다) ── -->
        <v:QuickAccessPanel x:Name="QuickPanel" Width="420" HorizontalAlignment="Right"
                            DataContext="{Binding QuickAccess}" m:Entrance.Stagger="Self" m:Entrance.Offset="80"
                            m:Reveal.IsShown="{Binding DataContext.IsQuickAccessOpen, RelativeSource={RelativeSource AncestorType=Window}}"
                            m:Reveal.ExitX="64"/>

        <!-- ── 실행 중: 흐르는 점 + 큰 글씨 ─────────────────── -->
        <Grid Background="{DynamicResource BackdropTint}" m:Reveal.IsShown="{Binding BusyText, Converter={x:Static local:HasValue.Instance}}"
              m:Reveal.ExitMs="220">
            <StackPanel VerticalAlignment="Center">
                <m:MetroDots HorizontalAlignment="Stretch" Margin="0,0,0,28"/>
                <!-- 긴 게임 이름도 잘리지 않게 두 줄까지 -->
                <TextBlock Text="{Binding BusyShown}" Style="{StaticResource H1}" Margin="48,0" m:Entrance.Stagger="Self"
                           TextWrapping="Wrap" MaxHeight="88" LineHeight="42" LineStackingStrategy="BlockLineHeight"/>
            </StackPanel>
        </Grid>

        <!-- ── 확인 대화 상자 (메트로 메시지 대화: 화면을 가로지르는 띠) ──────────
             열려 있는 동안 패드·키 입력은 여기로만 (MainWindow.Route). 바깥(어둡게 한 곳)을 누르면 취소 -->
        <Grid x:Name="ConfirmLayer" m:Reveal.IsShown="{Binding IsConfirmOpen}" m:Reveal.ExitMs="150"
              KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource Scrim}" MouseDown="ConfirmScrim_MouseDown"/>
            <Border VerticalAlignment="Center" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="0,1"
                    DataContext="{Binding ConfirmShown}">
                <Grid MaxWidth="760" Margin="48,32,48,32" m:Entrance.Stagger="Self" m:Entrance.Offset="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontFamily="{StaticResource LucideFont}" FontSize="32" VerticalAlignment="Top" Margin="0,4,20,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{StaticResource Icon.CircleAlert}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Danger}" Value="True">
                                        <Setter Property="Text" Value="{StaticResource Icon.TriangleAlert}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock Text="{Binding Message}" FontSize="17" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding HasMessage, Converter={StaticResource Vis}}"/>
                        <!-- 위험한 동작이면 처음 포커스는 취소 (A 두 번에 실행되지 않게), 아니면 확인 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                            <Button Style="{StaticResource DialogConfirm}" Content="{Binding ConfirmLabel}" Margin="0,0,12,0"
                                    Command="{Binding DataContext.ConfirmAcceptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    local:Nav.InitialFocus="{Binding Danger, Converter={x:Static local:InvertBool.Instance}}"/>
                            <Button Style="{StaticResource DialogCancel}" Content="{Binding CancelLabel}"
                                    Command="{Binding DataContext.CancelConfirmCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    local:Nav.InitialFocus="{Binding Danger}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── 알림 (메트로 토스트: 아래 가운데, 힌트 바 바로 위. 강조색 막대 + 카드, 두 줄까지) ──── -->
        <Border x:Name="ToastCard" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="40,0,40,64" MaxWidth="640" MinWidth="280"
                Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,1,1"
                m:Reveal.IsShown="{Binding Toast, Converter={x:Static local:HasValue.Instance}}" m:Reveal.EnterY="20" m:Reveal.ExitY="12"
                IsHitTestVisible="False">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="4" Background="{DynamicResource Accent}"/>
                <Grid Margin="16,13,22,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{StaticResource Icon.Info}" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ToastShown}" FontWeight="Medium" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="44"/>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
