<Window x:Class="ClawApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ClawApp.Views"
        xmlns:m="clr-namespace:ClawApp.Motion"
        Title="ClawHub" Icon="Assets/ClawHub.ico"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}" FontSize="16" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
      AllowsTransparency(레이어드 창)는 쓰지 않는다: ClearType이 꺼지고 글자가 뭉개진다.
      셸 화면은 흐린 게임 아트(Backdrop)가 창 전체를 덮고, 게임 위 오버레이일 때는 DWM Acrylic이 뒤 게임을 흐린다.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- ── 셸 화면 ─────────────────────────────────────── -->
        <Grid x:Name="Shell" Visibility="{Binding IsShellVisible, Converter={StaticResource Vis}}">
            <!-- 패널이 열리면 뒤 화면을 흐리게 (앱 안의 Acrylic) -->
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAnyPanelOpen}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value><BlurEffect Radius="24" KernelType="Gaussian" RenderingBias="Performance"/></Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="104"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- 배경: 지금 고른 게임의 아트를 크게 흐리고 어둡게 (두 층을 교차 페이드).
                 흐림은 층마다 BitmapCache(반 해상도)에 한 번만 그려진다 — 글자가 없는 층이라 화질 손해 없음 -->
            <Grid Grid.RowSpan="3" Background="{DynamicResource BackdropFallback}" ClipToBounds="True" IsHitTestVisible="False"
                  m:Backdrop.IsHost="True" m:Backdrop.Default="{Binding BackdropDefault}">
                <Grid Margin="-120" Opacity="0">
                    <Grid.CacheMode><BitmapCache RenderAtScale="0.5"/></Grid.CacheMode>
                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.Effect><BlurEffect Radius="{Binding BackdropBlur}" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
                    </Image>
                </Grid>
                <Grid Margin="-120" Opacity="0">
                    <Grid.CacheMode><BitmapCache RenderAtScale="0.5"/></Grid.CacheMode>
                    <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.Effect><BlurEffect Radius="{Binding BackdropBlur}" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
                    </Image>
                </Grid>
                <Rectangle Fill="{DynamicResource BackdropTintSolid}" Opacity="{Binding BackdropDim}"/>
                <Rectangle Fill="{DynamicResource BackdropShade}"/>
            </Grid>

            <!-- 상단: 피벗 제목 + 상태 -->
            <Grid Margin="48,14,40,0">
                <!-- 긴 제목은 상태 표시줄 앞에서 말줄임 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 상태 표시줄: 실행 중 게임 · 성능 · 온도 · 컨트롤러 · 네트워크 · 볼륨 · 배터리 · 시계. 누르면 그 항목의 패널이 열린다 (터치·마우스) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Button Style="{StaticResource StatusButton}" Command="{Binding RunningTile.OpenCommand}" ToolTip="실행 중인 게임"
                            Visibility="{Binding RunningGame, Converter={StaticResource NullVis}}" Background="{DynamicResource Accent}" MaxWidth="260">
                        <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource AccentText}">
                            <TextBlock Text="{StaticResource Icon.Play}" Style="{StaticResource StatusIcon}" FontSize="16" Foreground="{DynamicResource AccentText}"/>
                            <TextBlock Text="{Binding RunningGame.Title}" Style="{StaticResource StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="service" ToolTip="ClawHub 서비스 연결 안 됨"
                            Visibility="{Binding ServiceConnected, Converter={StaticResource NotVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.TriangleAlert}" Style="{StaticResource StatusIcon}" Foreground="{DynamicResource Warn}"/>
                            <TextBlock Text="서비스 꺼짐" Style="{StaticResource StatusText}" Foreground="{DynamicResource Warn}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="perf" ToolTip="성능 모드"
                            Visibility="{Binding PerfText, Converter={StaticResource NullVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PerfIcon}" Style="{StaticResource StatusIcon}"/>
                            <TextBlock Text="{Binding PerfText}" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="system" ToolTip="시스템 상태"
                            Visibility="{Binding CpuTempText, Converter={StaticResource NullVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Thermometer}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CpuHot}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource StatusText}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="controller" ToolTip="컨트롤러"
                            Visibility="{Binding ControllerConnected, Converter={StaticResource Vis}}">
                        <TextBlock Text="{StaticResource Icon.Gamepad2}" Style="{StaticResource StatusIcon}"/>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="network" ToolTip="{Binding NetworkText}">
                        <TextBlock Text="{Binding NetworkIcon}" Style="{StaticResource StatusIcon}"/>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="sound" ToolTip="밝기·소리"
                            Visibility="{Binding VolumeText, Converter={StaticResource NullVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding VolumeIcon}" Style="{StaticResource StatusIcon}"/>
                            <TextBlock Text="{Binding VolumeText}" Style="{StaticResource StatusText}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="battery" ToolTip="배터리">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding BatteryIcon}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BatteryLow}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource StatusText}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <!-- 구분선 뒤 시계: 같은 16px, 굵기만 다르게 -->
                    <Border Width="1" Height="20" Background="{DynamicResource StrokeStrong}" Opacity="0.5" Margin="8,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenStatusCommand}" CommandParameter="clock" ToolTip="날짜·시간">
                        <TextBlock Text="{Binding Clock}" Style="{StaticResource StatusText}" FontWeight="SemiBold" Margin="0"/>
                    </Button>
                    <!-- 터치용 빠른 설정 (패드는 QS 버튼) -->
                    <Button Style="{StaticResource StatusButton}" Command="{Binding OpenQuickSettingsCommand}" ToolTip="빠른 설정">
                        <TextBlock Text="{StaticResource Icon.SlidersHorizontal}" Style="{StaticResource StatusIcon}"/>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,24,0">
                    <TextBlock Text="CLAWHUB" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextDim}" Margin="1,0,0,0"/>
                    <TextBlock x:Name="PivotHeader" Text="{Binding PageTitle}" Style="{StaticResource PivotTitle}" Margin="-2,-4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 페이지 -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"
                            PreviewGotKeyboardFocus="PageHost_GotKeyboardFocus"/>

            <!-- 하단 버튼 힌트 -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Hints}" HorizontalAlignment="Right" Margin="0,0,40,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 패드 버튼 그림 (A/B/X/Y는 Xbox 색 그대로, LB·RB·☰·… 는 글자색 실루엣) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                            <v:ButtonGlyph Key="{Binding Glyph}" Width="28" Height="28" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ── 패널 뒤 어둡게 ─────────────────────────────── -->
        <Border Background="{DynamicResource Scrim}" Visibility="{Binding IsAnyPanelOpen, Converter={StaticResource Vis}}"
                MouseDown="Scrim_MouseDown"/>

        <!-- ── 상태 표시줄 항목 패널 (표시줄 바로 아래 오른쪽) ── -->
        <v:StatusFlyout x:Name="StatusFlyout" Width="400" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,40,0"
                        m:Entrance.Stagger="Self" m:Entrance.Offset="24"
                        Visibility="{Binding StatusPanel, Converter={StaticResource NullVis}}"/>

        <!-- ── 빠른 설정 (오른쪽 가장자리에서 미끄러져 나오는 참 바) ── -->
        <v:QuickAccessPanel x:Name="QuickPanel" Width="420" HorizontalAlignment="Right"
                            DataContext="{Binding QuickAccess}" m:Entrance.Stagger="Self" m:Entrance.Offset="80"
                            Visibility="{Binding DataContext.IsQuickAccessOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>

        <!-- ── 실행 중: 흐르는 점 + 큰 글씨 ─────────────────── -->
        <Grid Background="{DynamicResource BackdropTint}" Visibility="{Binding BusyText, Converter={StaticResource NullVis}}">
            <StackPanel VerticalAlignment="Center">
                <m:MetroDots HorizontalAlignment="Stretch" Margin="0,0,0,28"/>
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource H1}" Margin="48,0" m:Entrance.Stagger="Self"/>
            </StackPanel>
        </Grid>

        <!-- ── 알림 (메트로 토스트: 오른쪽 위, 강조색 막대) ──── -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,24,40,0" MaxWidth="560"
                Background="{DynamicResource Bg1}" Visibility="{Binding Toast, Converter={StaticResource NullVis}}"
                IsHitTestVisible="False" m:Entrance.Stagger="Self" m:Entrance.Offset="48">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="6" Background="{DynamicResource Accent}"/>
                <StackPanel Orientation="Horizontal" Margin="16,12,20,12">
                    <TextBlock Text="{StaticResource Icon.Info}" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" MaxWidth="480" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
