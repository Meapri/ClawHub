<!--
  메트로(Windows Phone / Windows 8) 디자인 언어 + 흐린 게임 아트 배경.
   · 글자 우선: 크고 굵은 피벗 제목, 가벼운 캡션, 넉넉한 여백, 왼쪽 정렬.
   · 평평한 직각 타일: 둥근 모서리·그림자 없음. 기능 타일은 강조색 단색, 그 밖의 면은 배경이 비치는 반투명.
   · 포커스: 3px 테두리 + 안쪽 1px 대비선 (패드로 어디 있는지 항상 분명하게). 테두리는 바깥에서 '찰칵' 조여 들어온다(FocusPop).
   · 누름: 살짝 눌렸다 돌아오는 틸트(Press.Scale).
  색은 Themes/Colors.{Light|Dark}.xaml에서 오고(시스템 테마·강조색을 따라감), 여기서는 모두 DynamicResource로 참조한다.
  글자 선명도: 효과(DropShadow/Blur)·비정수 배율을 글자에 걸지 않는다 — 모션은 끝나면 항상 원래 변환(없음)으로 돌아온다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="clr-namespace:ClawApp.Motion"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Lucide 아이콘 글꼴 + Icon.* 글자 (단색 선 아이콘, shadcn 느낌) -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Icons.xaml"/>
        <ResourceDictionary Source="Themes/Art.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Pretendard 내장 (Fonts/*.otf, SIL OFL 1.1). 한글·영문이 한 폰트라 글꼴이 섞여 보이지 않는다 -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Fonts/#Pretendard, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Pretendard, Segoe UI, Malgun Gothic</FontFamily>

    <!-- 메트로: 직각 -->
    <CornerRadius x:Key="ControlRadius">0</CornerRadius>
    <CornerRadius x:Key="CardRadius">0</CornerRadius>

    <!-- ── 텍스트 ───────────────────────────────────────── -->
    <!--
      글자 크기 단계 (8인치 1280×800 논리 px, 팔 길이 거리에서 읽는 기준):
        캡션 14 · 본문 16 (창 기본값) · 섹션 18 · H2 22 · 피벗 탭 26 · H1 32 · 피벗 제목 46.
      화면에서 FontSize를 따로 주지 말고 이 스타일을 쓴다. 13 미만은 쓰지 않는다.
    -->
    <!-- 상단 피벗 제목 (페이지 이름) -->
    <Style x:Key="PivotTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- 페이지 안의 피벗 머리글 (LB/RB 탭) -->
    <Style x:Key="PivotItem" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PivotDim}"/>
    </Style>
    <!-- 홈 타일 그룹 이름 -->
    <Style x:Key="GroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="m:Entrance.Include" Value="True"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Margin" Value="2,24,0,8"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 줄 안의 아이콘 (Lucide). Text="{StaticResource Icon.X}" -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LucideFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── 상단 상태 표시줄: 모든 항목이 같은 높이·아이콘 크기·글자 크기 ── -->
    <Style x:Key="StatusItem" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="20,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 상태 표시줄 항목 = 누르면 패널이 열리는 버튼 (터치·마우스용, 패드는 빠른 설정으로) -->
    <Style x:Key="StatusButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 손가락 크기: 44×44 이상 -->
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"/>
                        <Border x:Name="Hover" Background="{DynamicResource TileFillHover}" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.6"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StatusIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="FontSize" Value="22"/>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ── 포커스 테두리 (모든 컨트롤 공통) ───────────────── -->
    <!-- 바깥 3px (FocusOuter) + 안쪽 1px (FocusInner). 평소에는 투명, 포커스 때만 색이 들어온다 -->
    <Style x:Key="FocusRing" TargetType="Border">
        <Setter Property="Margin" Value="-4"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="m:FocusPop.IsEnabled" Value="True"/>
    </Style>
    <Style x:Key="FocusRingInner" TargetType="Border">
        <Setter Property="Margin" Value="-1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ── 카드 (설정 묶음) ───────────────────────────────── -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ── 버튼 (목록 행) ─────────────────────────────────── -->
    <!-- 목록 행·스위치·카드의 글자는 모두 왼쪽 20에서 시작한다 (테두리 1 포함 19) -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="19,14"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="m:Press.Scale" Value="0.98"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 왼쪽 탐색 항목 (설정 분류 등). 글자 위주, 선택 시 강조색 막대 + 밝은 글자 ── -->
    <Style x:Key="NavItem" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="m:Press.Scale" Value="0.98"/>
        <!-- Tag=True 이면 선택됨 -->
        <Setter Property="Tag" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Pill" Width="4" HorizontalAlignment="Left" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}" Margin="-3"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}" Margin="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFill}"/>
                        </Trigger>
                        <!-- Tag는 object라 일반 Trigger는 bool true와 "True"를 비교하지 못함 → DataTrigger -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFill}"/>
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 강조 버튼 (플레이) ────────────────────────────── -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Padding" Value="28,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="m:Press.Scale" Value="0.95"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Hover" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 메트로 타일 (홈 그리드의 기본 단위) ──────────────
         크기: 작게 80×80 · 보통 168×168 · 넓게 344×168 · 크게 344×344 (간격 8)
         내용은 사용하는 쪽이 채운다. 기본 색은 강조색 단색. -->
    <!-- 타일 색 층의 불투명도 (설정 → 홈 화면 → 타일 투명도). 코드가 덮어쓴다 -->
    <sys:Double x:Key="TileBackgroundOpacity">1</sys:Double>

    <Style x:Key="MetroTile" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource TileAccent}"/>
        <Setter Property="Foreground" Value="{DynamicResource TileAccentText}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Width" Value="168"/>
        <Setter Property="Height" Value="168"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="m:Press.Scale" Value="0.94"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 그림 층 (타일 그림 모드) → 타일 색 (투명도 설정) → 내용 -->
                        <Border m:TilePicture.Host="True"/>
                        <Border Background="{TemplateBinding Background}" Opacity="{DynamicResource TileBackgroundOpacity}"/>
                        <Border x:Name="Bd" ClipToBounds="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Border x:Name="Hover" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}" Margin="-5" BorderThickness="4"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 기능 타일: Tag = 아이콘 이름 (Assets/Emoji/{Tag}.png, Fluent Emoji 3D), Content = 이름. 아이콘과 이름 모두 왼쪽 아래 -->
    <Style x:Key="FunctionTile" TargetType="Button" BasedOn="{StaticResource MetroTile}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border m:TilePicture.Host="True"/>
                        <Border Background="{TemplateBinding Background}" Opacity="{DynamicResource TileBackgroundOpacity}"/>
                        <Border x:Name="Bd" ClipToBounds="True">
                            <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource LucideFont}" FontSize="34"
                                           Foreground="{TemplateBinding Foreground}" Margin="-1,0,0,12"/>
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Hover" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}" Margin="-5" BorderThickness="4"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 반투명(유리) 기능 타일: 강조색 타일 사이에 리듬을 준다 -->
    <Style x:Key="GlassTile" TargetType="Button" BasedOn="{StaticResource FunctionTile}">
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource TileText}"/>
    </Style>
    <!-- 위험 동작 타일 (게임 종료) -->
    <Style x:Key="DangerTile" TargetType="Button" BasedOn="{StaticResource FunctionTile}">
        <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
        <Setter Property="m:TilePicture.Skip" Value="True"/>
    </Style>

    <!-- 작은 타일 (80×80): 아이콘 + 짧은 이름. 전원 묶음 등 -->
    <Style x:Key="SmallTile" TargetType="Button" BasedOn="{StaticResource MetroTile}">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource TileText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border m:TilePicture.Host="True"/>
                        <Border Background="{TemplateBinding Background}" Opacity="{DynamicResource TileBackgroundOpacity}"/>
                        <Border x:Name="Bd">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource LucideFont}" FontSize="22"
                                           HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,6,0,0"
                                                  TextElement.FontSize="13" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Hover" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}" Margin="-5" BorderThickness="4"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 게임 커버 타일 (2:3). 확대 대신 포커스 테두리 — 글자 번짐 방지 ── -->
    <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource MetroTile}">
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Width" Value="168"/>
        <Setter Property="Height" Value="256"/>
    </Style>

    <!-- ── 토글 버튼 (선택형 칩: 성능 모드 등) ──────────── -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="16"/>
        <!-- 손가락 크기: 높이 44 이상 -->
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="m:Press.Scale" Value="0.95"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipRadio" TargetType="RadioButton" BasedOn="{StaticResource Chip}"/>

    <!-- ── 빠른 설정 타일 (정사각 메트로 타일: 아이콘 위, 이름 아래 왼쪽) ── -->
    <!-- 빠른 설정 패널(420) 안쪽 369에 한 줄 3개: 3 × (112 + 8) = 360 -->
    <Style x:Key="QuickTile" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
        <Setter Property="Width" Value="112"/>
        <Setter Property="Height" Value="88"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="12,10">
                            <Grid>
                                <!-- Tag = Lucide 아이콘 글자 -->
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource LucideFont}" FontSize="22"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Bottom" TextElement.FontSize="15"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuickTileRadio" TargetType="RadioButton" BasedOn="{StaticResource QuickTile}"/>

    <!-- ── 토글 스위치 (Windows Phone식 직사각 트랙). 내용은 왼쪽, 스위치는 오른쪽 ── -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="m:Press.Scale" Value="0.98"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock x:Name="State" Text="끔" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextDim}"/>
                                    <Grid Width="48" Height="24">
                                        <Border x:Name="Track" BorderThickness="2" BorderBrush="{DynamicResource StrokeStrong}" Background="Transparent"/>
                                        <Border x:Name="Knob" Width="12" Height="12" Margin="6,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource TextDim}"/>
                                    </Grid>
                                </StackPanel>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource AccentText}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="State" Property="Text" Value="켬"/>
                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 슬라이더 (메트로: 굵은 직사각 트랙 + 세로 막대 손잡이) ──
         높이 44 = 손가락으로 집기 쉬운 크기. 손잡이는 보이는 막대(12×28)보다 넓은 28×44 영역으로 잡힌다.
         패드: 포커스가 오면 바탕이 밝아지고 테두리 두 겹, ←/→ = SmallChange만큼. -->
    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border x:Name="Bg" Background="Transparent"/>
                        <!-- 손잡이 영역 28 중 보이는 막대는 가운데 12 → 트랙·채움을 8씩 안쪽으로 맞춘다 -->
                        <Grid VerticalAlignment="Stretch" Margin="2,0">
                            <Border Height="8" Margin="8,0" Background="{DynamicResource StrokeStrong}" Opacity="0.5"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="8" Margin="8,0,-8,0" Background="{DynamicResource Accent}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="28" Background="Transparent">
                                                    <Border Width="12" Height="28" Background="{DynamicResource Text}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <Border x:Name="Ring" Style="{StaticResource FocusRing}" Margin="-1"/>
                        <Border x:Name="Inner" Style="{StaticResource FocusRingInner}" Margin="2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TileFill}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/>
                            <Setter TargetName="Inner" Property="BorderBrush" Value="{DynamicResource FocusInner}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 텍스트 입력 (A = 터치 키보드, 벗어나면 저장) ──── -->
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource TileFill}" BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg0}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="PanningMode" Value="Both"/>
    </Style>

    <!-- ── 페이지 도구 모음·목록 행 보조 (라이브러리·프로필·프로그램 추가) ── -->
    <!-- 도구 모음 버튼: 한 줄 높이 48, 여백 없이 (간격은 놓는 쪽이 Margin으로) -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- 아이콘만 있는 정사각 버튼 (손가락 크기 48) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <!-- 행 오른쪽 동작 버튼: 아이콘 위, 짧은 이름 아래 (64×64) -->
    <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
        <Setter Property="Width" Value="68"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- 작은 표시 (사용 중·기본 제공·실행 중). 강조색 바탕 -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentText}"/>
        <Setter Property="TextElement.FontSize" Value="13"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
    <!-- 테두리만 있는 표시 (덜 중요한 상태) -->
    <Style x:Key="BadgeOutline" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextDim}"/>
        <Setter Property="TextElement.FontSize" Value="13"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
    <!-- 터치로 고르는 피벗 탭 머리글 (패드는 LB/RB, 포커스는 받지 않는다) -->
    <Style x:Key="PivotTabButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,0,32,0" MinHeight="44">
                        <ContentPresenter VerticalAlignment="Top"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 하단 힌트 바의 버튼 글리프 (실제 패드 버튼 모양이라 둥글게 유지) -->
    <Style x:Key="HintGlyph" TargetType="Border">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Background" Value="{DynamicResource TileFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="22,0,8,0"/>
    </Style>
</ResourceDictionary>
