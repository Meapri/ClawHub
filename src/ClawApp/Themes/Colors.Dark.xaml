<!-- Windows 11 Fluent 다크 토큰 (WinUI ThemeResources 기준). Accent 계열은 시작 시 시스템 강조색으로 덮어쓴다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextDim" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#87FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#99EBFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#8BD9EB"/>
    <SolidColorBrush x:Key="AccentText" Color="#000000"/>
    <!-- 메트로 타일: 다크에서도 진한 기본 강조색 + 흰 글자 (밝은 강조색 위 흰 글자는 안 읽힘) -->
    <SolidColorBrush x:Key="TileAccent" Color="#0078D4"/>
    <SolidColorBrush x:Key="TileAccentText" Color="#FFFFFF"/>

    <!-- 컨트롤 / 카드 / 레이어 -->
    <SolidColorBrush x:Key="Surface" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="SurfacePressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="Stroke" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="Card" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="CardStroke" Color="#1A000000"/>
    <SolidColorBrush x:Key="SubtleHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SelectedFill" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#15FFFFFF"/>

    <!-- 창 배경: Mica/Acrylic 위에 얹는 레이어. 백드롭이 안 되면 Bg0 단색 -->
    <SolidColorBrush x:Key="Bg0" Color="#202020"/>
    <SolidColorBrush x:Key="Layer" Color="#4C3A3A3A"/>
    <!-- 플라이아웃(메뉴·빠른 설정) 패널 = Acrylic 틴트 -->
    <SolidColorBrush x:Key="Bg1" Color="#E62C2C2C"/>
    <SolidColorBrush x:Key="Scrim" Color="#4D000000"/>
    <SolidColorBrush x:Key="FocusOuter" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Good" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="Warn" Color="#FCE100"/>
    <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>

    <!-- ── 메트로 + 흐림 ───────────────────────────────────── -->
    <!-- 흐린 게임 아트 위에 까는 어둡게 하기 층 (아크릴 틴트) -->
    <SolidColorBrush x:Key="BackdropTint" Color="#B3101010"/>
    <!-- 배경 덮개 (불투명도는 설정 → 홈 화면 → 어둡기/밝기로) -->
    <!-- 홈 폴더 창 바탕: 반투명 타일이 잘 보이게 카드보다 한 톤 진하게 -->
    <SolidColorBrush x:Key="FolderCardFill" Color="#F21B1B20"/>
    <SolidColorBrush x:Key="BackdropTintSolid" Color="#101010"/>
    <!-- 화면 위쪽(제목)·아래쪽(힌트)을 조금 더 어둡게: 글자 대비 확보 -->
    <LinearGradientBrush x:Key="BackdropShade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66000000" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.3"/>
        <GradientStop Color="#00000000" Offset="0.8"/>
        <GradientStop Color="#80000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- 게임 아트가 없을 때의 배경 -->
    <LinearGradientBrush x:Key="BackdropFallback" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1B1B22" Offset="0"/>
        <GradientStop Color="#101012" Offset="1"/>
    </LinearGradientBrush>
    <!-- 반투명 타일·카드 (배경이 비쳐 보이는 유리판) -->
    <SolidColorBrush x:Key="TileFill" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TileFillHover" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="TileText" Color="#FFFFFF"/>
    <!-- 포커스 테두리 안쪽의 얇은 대비선 (밝은 아트 위에서도 보이게) -->
    <SolidColorBrush x:Key="FocusInner" Color="#B3000000"/>
    <!-- 위험 동작 타일 (게임 종료): 메트로 레드 -->
    <SolidColorBrush x:Key="DangerFill" Color="#E51400"/>
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF"/>
    <!-- 피벗에서 선택되지 않은 머리글 -->
    <SolidColorBrush x:Key="PivotDim" Color="#66FFFFFF"/>
</ResourceDictionary>
