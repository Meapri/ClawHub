<!-- Windows 11 Fluent 다크 토큰 (WinUI ThemeResources 기준). Accent 계열은 시작 시 시스템 강조색으로 덮어쓴다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextDim" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#87FFFFFF"/>

    <SolidColorBrush x:Key="Accent" Color="#99EBFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#8BD9EB"/>
    <SolidColorBrush x:Key="AccentText" Color="#000000"/>

    <!-- 컨트롤 / 카드 / 레이어 -->
    <SolidColorBrush x:Key="Surface" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="SurfacePressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="Stroke" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="Card" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="CardStroke" Color="#1A000000"/>
    <SolidColorBrush x:Key="SubtleHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SelectedFill" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#15FFFFFF"/>

    <!-- 창 배경: Mica/Acrylic 위에 얹는 레이어. 백드롭이 안 되면 Bg0 단색 -->
    <SolidColorBrush x:Key="Bg0" Color="#202020"/>
    <SolidColorBrush x:Key="Layer" Color="#4C3A3A3A"/>
    <!-- 플라이아웃(메뉴·빠른 설정) 패널 = Acrylic 틴트 -->
    <SolidColorBrush x:Key="Bg1" Color="#E62C2C2C"/>
    <SolidColorBrush x:Key="Scrim" Color="#4D000000"/>
    <SolidColorBrush x:Key="FocusOuter" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Good" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="Warn" Color="#FCE100"/>
    <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>
</ResourceDictionary>
