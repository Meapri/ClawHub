<!-- Windows 11 Fluent 라이트 토큰 (WinUI ThemeResources 기준). Accent 계열은 시작 시 시스템 강조색으로 덮어쓴다. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Text" Color="#E4000000"/>
    <SolidColorBrush x:Key="TextDim" Color="#9E000000"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#72000000"/>

    <SolidColorBrush x:Key="Accent" Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentHover" Color="#196EBF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Surface" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHi" Color="#80F9F9F9"/>
    <SolidColorBrush x:Key="SurfacePressed" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="Stroke" Color="#0F000000"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#72000000"/>
    <SolidColorBrush x:Key="Card" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="CardStroke" Color="#0F000000"/>
    <SolidColorBrush x:Key="SubtleHover" Color="#09000000"/>
    <SolidColorBrush x:Key="SelectedFill" Color="#09000000"/>
    <SolidColorBrush x:Key="Divider" Color="#14000000"/>

    <SolidColorBrush x:Key="Bg0" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Layer" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Bg1" Color="#F2F9F9F9"/>
    <SolidColorBrush x:Key="Scrim" Color="#33000000"/>
    <SolidColorBrush x:Key="FocusOuter" Color="#E4000000"/>

    <SolidColorBrush x:Key="Good" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="Warn" Color="#9D5D00"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
</ResourceDictionary>
