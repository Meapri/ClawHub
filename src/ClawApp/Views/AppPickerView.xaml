<UserControl x:Class="ClawApp.Views.AppPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             xmlns:m="clr-namespace:ClawApp.Motion"
             xmlns:v="clr-namespace:ClawApp.Views"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <!--
        프로그램 추가: 위 = 검색(LT) · 파일에서 고르기(Y), 그 아래 = 추가할 분류(앱 LB / 게임 RB)를 크게,
        방금 한 일 줄(추가·되돌리기 X), 아래 = 시작 메뉴 프로그램 타일 (A = 추가, 연달아 여러 개 가능).
    -->
    <UserControl.Resources>
        <!-- 분류 선택지: 아이콘 + 이름 + 한 줄 설명, 고르면 강조색 -->
        <Style x:Key="KindChoice" TargetType="RadioButton" BasedOn="{StaticResource ChipRadio}">
            <Setter Property="MinWidth" Value="250"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="48,0,40,12">
        <!-- 검색 · 파일에서 고르기 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding PickFileCommand}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <v:ButtonGlyph Key="Y" Width="24" Height="24" Margin="0,0,10,0"/>
                    <TextBlock Text="파일에서 고르기" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ClearQueryCommand}" Margin="4,0,0,0" ToolTip="검색 지우기"
                    Visibility="{Binding HasQuery, Converter={StaticResource Vis}}">
                <TextBlock Text="{StaticResource Icon.X}" Style="{StaticResource Icon}"/>
            </Button>
            <Grid>
                <v:InlineEdit x:Name="SearchBox" Text="{Binding Query}" Placeholder="이름으로 찾기 (LT · A를 누르면 키보드)" InnerPadding="44,0,18,0" Height="48"/>
                <TextBlock Text="{StaticResource Icon.Search}" Style="{StaticResource Icon}" Margin="16,0,0,0" HorizontalAlignment="Left"
                           IsHitTestVisible="False" Opacity="0.7"/>
            </Grid>
        </DockPanel>

        <!-- 추가할 분류: 앱(게임 아님) / 게임 — LB/RB로도 바꾼다 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Style="{StaticResource KindChoice}" GroupName="kind" IsChecked="{Binding AddAsApp}">
                <DockPanel>
                    <v:ButtonGlyph DockPanel.Dock="Left" Key="LB" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.AppWindow}" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="앱으로 추가" FontWeight="SemiBold"/>
                        <TextBlock Text="브라우저·메신저 등" FontSize="13" Opacity="0.8"/>
                    </StackPanel>
                </DockPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource KindChoice}" GroupName="kind" IsChecked="{Binding AddAsGame}">
                <DockPanel>
                    <v:ButtonGlyph DockPanel.Dock="Left" Key="RB" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Gamepad2}" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="게임으로 추가" FontWeight="SemiBold"/>
                        <TextBlock Text="매핑·성능 모드 사용" FontSize="13" Opacity="0.8"/>
                    </StackPanel>
                </DockPanel>
            </RadioButton>
            <TextBlock Text="{Binding KindNote}" Style="{StaticResource Caption}" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0"
                       TextWrapping="NoWrap"/>
        </StackPanel>

        <!-- 방금 한 일 (추가·되돌리기) — 없으면 목록 개수 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10" MinHeight="48">
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,0,0"
                       Visibility="{Binding HasLastAction, Converter={StaticResource NotVis}}"/>
            <Border Style="{StaticResource CardPanel}" Padding="16,0" Margin="0" Visibility="{Binding LastAction, Converter={StaticResource NullVis}}">
                <DockPanel MinHeight="48">
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" Height="40" Margin="12,4,-12,4"
                            Visibility="{Binding CanUndo, Converter={StaticResource Vis}}" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <v:ButtonGlyph Key="X" Width="22" Height="22" Margin="0,0,8,0"/>
                            <TextBlock Text="{StaticResource Icon.Undo2}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="되돌리기" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SessionText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextWrapping="NoWrap"/>
                    <TextBlock Text="{StaticResource Icon.CircleCheck}" Style="{StaticResource Icon}" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding LastAction}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>

        <Grid>
            <StackPanel VerticalAlignment="Top" Margin="2,8,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                <TextBlock Text="찾는 프로그램이 없어요" Style="{StaticResource H2}"/>
                <TextBlock Text="목록은 시작 메뉴에서 읽어요. 게임 실행 파일이나 바로가기를 직접 고를 수 있어요." Style="{StaticResource Caption}" FontSize="16"
                           Margin="0,8,0,16"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PickFileCommand}" HorizontalAlignment="Left" MinWidth="220" Height="52">
                    <TextBlock Text="파일에서 고르기"/>
                </Button>
            </StackPanel>
            <ScrollViewer Margin="-6,-6,-6,0" Visibility="{Binding IsEmpty, Converter={StaticResource NotVis}}">
                <ItemsControl x:Name="List" ItemsSource="{Binding Items}" Focusable="False" Margin="6,6,6,12" m:Entrance.Stagger="Items" m:Entrance.Offset="24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Item" Style="{StaticResource NavButton}" Width="282" Height="76" Margin="0,0,8,8" Padding="16,0"
                                    HorizontalContentAlignment="Stretch" local:Nav.InitialFocus="True"
                                    Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,14,0">
                                            <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{StaticResource Icon.AppWindow}" Style="{StaticResource Icon}" FontSize="26" HorizontalAlignment="Center"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource NotVis}}"/>
                                        </Grid>
                                        <!-- 이미 라이브러리에 있으면 체크 -->
                                        <TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.CircleCheck}" Style="{StaticResource Icon}"
                                                   Foreground="{DynamicResource Accent}" Margin="10,0,0,0"
                                                   Visibility="{Binding IsAdded, Converter={StaticResource Vis}}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="Sub" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Folder, TargetNullValue=시작 메뉴}"/>
                                        </StackPanel>
                                    </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                    <Setter TargetName="Sub" Property="Text" Value="{Binding StatusText}"/>
                                    <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource Accent}"/>
                                    <!-- 추가된 항목: 강조색 테두리 (포커스 테두리와 겹쳐도 보이는 1px 안쪽 선) -->
                                    <Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
