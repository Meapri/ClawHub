<UserControl x:Class="ClawApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <Grid Margin="32,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 게임이 하나도 없을 때 -->
        <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
            <TextBlock Text="아직 게임이 없어요" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
            <TextBlock Text="설정 → 게임 추가에서 실행 파일을 고르거나, Steam·Epic에 설치하면 자동으로 나타납니다."
                       Style="{StaticResource Caption}" Margin="0,10,0,24" HorizontalAlignment="Center"/>
            <Button Style="{StaticResource PrimaryButton}" Content="설정 열기" HorizontalAlignment="Center" local:Nav.InitialFocus="True"
                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <!-- 히어로: 최근 게임 -->
        <Grid Visibility="{Binding IsEmpty, Converter={StaticResource NotVis}}" Margin="0,0,32,0" Height="300">
            <Border CornerRadius="16" ClipToBounds="True" Background="{Binding Hero.Placeholder}">
                <Grid>
                    <Image Source="{Binding Hero.Hero}" Stretch="UniformToFill"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E60B0F14" Offset="0"/>
                                <GradientStop Color="#000B0F14" Offset="0.75"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Image Source="{Binding Hero.Icon}" Width="96" Height="96" HorizontalAlignment="Right" Margin="0,0,64,0" Opacity="0.9"
                           Visibility="{Binding Hero.HasCover, Converter={StaticResource NotVis}}"/>
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Bottom" Margin="36,0,0,32">
                <TextBlock Text="{Binding Hero.LastPlayedLabel}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Hero.Title}" Style="{StaticResource H1}" FontSize="40" MaxWidth="700" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Hero.ProfileLabel}" Style="{StaticResource Caption}" Margin="0,4,0,18"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding Hero.PlayCommand}" local:Nav.InitialFocus="True" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="플레이"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding Hero.OpenCommand}" Margin="0" Padding="22,14" FontSize="18">
                        <TextBlock Text="자세히"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 최근/전체 줄 -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource NotVis}}" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Top" Text="최근 플레이" Style="{StaticResource Section}" Margin="2,4,0,0"/>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="-10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource CoverTile}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- 라이브러리 바로가기 타일 -->
                    <Button Style="{StaticResource TileButton}" Width="168" Height="252" Margin="10,10,32,10"
                            Command="{Binding DataContext.OpenLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="라이브러리 전체" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
