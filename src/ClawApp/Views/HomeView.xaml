<UserControl x:Class="ClawApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             xmlns:m="clr-namespace:ClawApp.Motion"
             xmlns:v="clr-namespace:ClawApp.Views"
             xmlns:vm="clr-namespace:ClawApp.ViewModels"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <!--
      Windows 10 Mobile식 시작 화면: 고정한 정사각형 타일(작게 80 · 보통 168 · 크게 344)을 가로로 흐르는 판에 빈틈없이 채운다.
      편집: 길게 누르기(터치) · 오른쪽 클릭 · 패드 Y → 끌어서 옮기기, 다른 타일 가운데에 대면 폴더, 모서리 버튼으로 고정 해제·크기.
      게임 중이면 맨 앞에 "지금 플레이 중" 묶음.
    -->
    <UserControl.Resources>
        <!-- 편집 중 타일 모서리의 동그란 버튼 (터치·마우스용, 패드는 X·Y·RB) -->
        <Style x:Key="TileEditButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{DynamicResource Text}" Stroke="{DynamicResource Bg0}" StrokeThickness="2"/>
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource LucideFont}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource Bg0}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 작은 타일(80px)엔 작게 -->
                <DataTrigger Binding="{Binding IsSmall}" Value="True">
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="FontSize" Value="13"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ScaleTransform x:Key="DimScale" ScaleX="0.9" ScaleY="0.9"/>
        <ScaleTransform x:Key="LiftScale" ScaleX="1.06" ScaleY="1.06"/>

        <!-- 끌거나 고른 타일이 이웃 위로 -->
        <Style x:Key="StartTileContainer" TargetType="ContentPresenter">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Panel.ZIndex" Value="5"/></DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Panel.ZIndex" Value="10"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StartTile" DataType="{x:Type vm:StartTileViewModel}">
            <Grid x:Name="Root" Width="{Binding Pixels}" Height="{Binding Pixels}" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                <Button x:Name="Tile" Style="{StaticResource MetroTile}" Width="{Binding Pixels}" Height="{Binding Pixels}" Margin="0"
                        Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" m:Backdrop.FocusSource="{Binding Art}">
                    <Grid ClipToBounds="True">
                        <!-- 게임 아트 (정사각형으로 가운데를 잘라 씀) -->
                        <Border Visibility="{Binding HasArt, Converter={StaticResource Vis}}">
                            <Border.Background><ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <Border x:Name="Shade" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.45"/>
                                    <GradientStop Color="#C0000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 아이콘: 기능·작은 폴더·아트 없는 이어서 플레이 = 글리프, 앱·아트 없는 게임 = 실행 파일 아이콘 -->
                        <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{StaticResource LucideFont}" FontSize="34"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,42"/>
                        <Image x:Name="AppIcon" Source="{Binding Game.Icon}" Width="48" Height="48" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- 폴더: 안에 든 타일의 축소판을 3열 격자로 (보통 2줄 · 크게 3줄), 아래에 이름과 개수 -->
                        <ItemsControl x:Name="Previews" ItemsSource="{Binding Previews}" Focusable="False" Margin="10,10,0,0" Visibility="Collapsed"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Width="{Binding PreviewGridWidth}" Height="{Binding PreviewGridHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Cell" Margin="0,0,4,4" ClipToBounds="True" Background="{DynamicResource TileFill}"
                                            Width="{Binding DataContext.PreviewCell, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Height="{Binding DataContext.PreviewCell, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Grid Margin="0,0,4,4" Background="Transparent">
                                            <Border Visibility="{Binding Art, Converter={StaticResource NullVis}}">
                                                <Border.Background><ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill"/></Border.Background>
                                            </Border>
                                            <Image Source="{Binding Icon}" Margin="8" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullVis}}"/>
                                            <Viewbox x:Name="GlyphBox" Margin="10" Visibility="Collapsed">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource LucideFont}"/>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- 기능 타일 = 강조색 칸 / 유리 기능 타일 = 흰 반투명 칸 -->
                                        <DataTrigger Binding="{Binding Accent}" Value="True">
                                            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource TileAccent}"/>
                                            <Setter TargetName="GlyphBox" Property="TextElement.Foreground" Value="{DynamicResource TileAccentText}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Art}" Value="{x:Null}"/>
                                                <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="GlyphBox" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 폴더 이름 · 개수 -->
                        <DockPanel x:Name="FolderLabel" VerticalAlignment="Bottom" Margin="12,0,10,10" Visibility="Collapsed">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource TileAccent}" MinWidth="22" Height="22" Padding="6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TileAccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Folder}" FontFamily="{StaticResource LucideFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- 작은 폴더: 아이콘 + 개수 -->
                        <Border x:Name="SmallCount" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                Background="{DynamicResource TileAccent}" MinWidth="18" Height="18" Padding="4,0">
                            <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TileAccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- 로고 / 이름 (작은 타일은 없음) -->
                        <Image Source="{Binding Game.Logo}" MaxHeight="72" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Margin="12,0,12,12" Visibility="{Binding ShowLogo, Converter={StaticResource Vis}}"/>
                        <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Bottom" Margin="14,0,14,12" Visibility="{Binding ShowLabel, Converter={StaticResource Vis}}"/>
                        <!-- 이어서 플레이 표시 -->
                        <Border x:Name="ContinueBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                Background="{DynamicResource TileAccent}" Padding="8,3">
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource TileAccentText}">
                                <TextBlock Text="{StaticResource Icon.Play}" FontFamily="{StaticResource LucideFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="이어서 플레이" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Button>

                <!-- 끌어 온 타일을 놓으면 폴더가 됨 -->
                <Border x:Name="MergeHint" BorderBrush="{DynamicResource Accent}" BorderThickness="5" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#40000000">
                    <TextBlock Text="{StaticResource Icon.Folder}" FontFamily="{StaticResource LucideFont}" FontSize="40" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 편집 중 고른 타일의 모서리 버튼 -->
                <Grid x:Name="EditButtons" Visibility="Collapsed" Margin="-12">
                    <Button Style="{StaticResource TileEditButton}" Content="{StaticResource Icon.PinOff}" ToolTip="고정 해제"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource TileEditButton}" Content="{StaticResource Icon.Scaling}" ToolTip="크기"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Command="{Binding DataContext.ResizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource TileEditButton}" Content="{StaticResource Icon.FolderOutput}" ToolTip="폴더에서 꺼내기"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{Binding IsInFolder, Converter={StaticResource Vis}}"
                            Command="{Binding DataContext.TakeOutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource TileEditButton}" Content="{StaticResource Icon.FolderPen}" ToolTip="폴더 이름"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding IsFolder, Converter={StaticResource Vis}}"
                            Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <!-- 유리 타일 (설정·폴더·게임 등) -->
                <DataTrigger Binding="{Binding IsGlass}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource TileFill}"/>
                    <Setter TargetName="Tile" Property="Foreground" Value="{DynamicResource TileText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsContinue}" Value="True">
                    <Setter TargetName="ContinueBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource TileFill}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasArt}" Value="True">
                    <Setter TargetName="Shade" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tile" Property="Foreground" Value="White"/>
                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- 게임·앱: 글리프 대신 실행 파일 아이콘 (아트가 없을 때) -->
                <DataTrigger Binding="{Binding Kind}" Value="Game">
                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="Game"/>
                        <Condition Binding="{Binding HasArt}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="AppIcon" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- 폴더: 보통·크게면 축소판 격자 + 이름·개수, 작게면 폴더 아이콘 + 개수 -->
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Previews" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="FolderLabel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="True"/>
                        <Condition Binding="{Binding IsSmall}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Previews" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FolderLabel" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="SmallCount" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- 작은 타일: 아이콘만 가운데 -->
                <DataTrigger Binding="{Binding IsSmall}" Value="True">
                    <Setter TargetName="Glyph" Property="FontSize" Value="24"/>
                    <Setter TargetName="Glyph" Property="HorizontalAlignment" Value="Center"/>
                    <Setter TargetName="Glyph" Property="VerticalAlignment" Value="Center"/>
                    <Setter TargetName="Glyph" Property="Margin" Value="0"/>
                    <Setter TargetName="AppIcon" Property="Width" Value="36"/>
                    <Setter TargetName="AppIcon" Property="Height" Value="36"/>
                    <Setter TargetName="ContinueBadge" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLarge}" Value="True">
                    <Setter TargetName="Glyph" Property="FontSize" Value="56"/>
                    <Setter TargetName="Label" Property="FontSize" Value="20"/>
                    <Setter TargetName="AppIcon" Property="Width" Value="96"/>
                    <Setter TargetName="AppIcon" Property="Height" Value="96"/>
                </DataTrigger>
                <!-- 편집: 고르지 않은 타일은 작고 흐리게, 고른 타일은 모서리 버튼 -->
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                    <Setter TargetName="Root" Property="RenderTransform" Value="{StaticResource DimScale}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEditing}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="EditButtons" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsGrabbed}" Value="True">
                    <Setter TargetName="Root" Property="RenderTransform" Value="{StaticResource LiftScale}"/>
                    <Setter TargetName="EditButtons" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="Root" Property="RenderTransform" Value="{StaticResource LiftScale}"/>
                    <Setter TargetName="Root" Property="Opacity" Value="0.9"/>
                    <Setter TargetName="EditButtons" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                    <Setter TargetName="MergeHint" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                  PanningMode="HorizontalOnly" PreviewMouseWheel="Scroller_Wheel" Background="Transparent">
        <StackPanel Orientation="Horizontal" Margin="48,24,48,0" VerticalAlignment="Top" m:Entrance.Stagger="Tiles">

            <!-- ── 지금 플레이 중 (게임 실행 중일 때만) ───────── -->
            <StackPanel Margin="0,0,40,0"
                        Visibility="{Binding DataContext.IsGameRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                <TextBlock Text="지금 플레이 중" Style="{StaticResource GroupHeader}"/>
                <Button Style="{StaticResource MetroTile}" Width="344" Height="344" local:Nav.InitialFocus="True"
                        Command="{Binding DataContext.ReturnToBackgroundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        m:Backdrop.FocusSource="{Binding RunningTile.Hero}">
                    <Grid TextElement.Foreground="White">
                        <Border Background="{Binding RunningTile.Placeholder}"/>
                        <Border Visibility="{Binding RunningTile.HasHero, Converter={StaticResource Vis}, FallbackValue=Collapsed}">
                            <Border.Background><ImageBrush ImageSource="{Binding RunningTile.Hero}" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.35"/>
                                    <GradientStop Color="#D0000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- 실행 중 표시: 강조색 띠 -->
                        <Border Height="6" VerticalAlignment="Top" Background="{DynamicResource Accent}"/>
                        <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,16">
                            <Image Source="{Binding RunningTile.Logo}" MaxWidth="240" MaxHeight="80" HorizontalAlignment="Left" Stretch="Uniform"
                                   Margin="0,0,0,10" Visibility="{Binding RunningTile.HasLogo, Converter={StaticResource Vis}, FallbackValue=Collapsed}"/>
                            <TextBlock Text="{Binding RunningGameTitle}" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding RunningTile.HasLogo, Converter={StaticResource NotVis}, FallbackValue=Visible}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{StaticResource Icon.Play}" Style="{StaticResource Icon}" FontSize="17" Margin="0,0,10,0"/>
                                <TextBlock Text="게임으로 돌아가기" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <!-- 실수로 끄지 않게 두 번 눌러야 종료 (토스트로 안내) -->
                    <Button Style="{StaticResource DangerTile}" Tag="{StaticResource Icon.CircleStop}" Content="게임 종료"
                            Command="{Binding DataContext.QuitGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Style="{StaticResource GlassTile}" Tag="{StaticResource Icon.Info}" Content="게임 정보"
                            Command="{Binding DataContext.RunningTile.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </StackPanel>

            <!-- ── 시작 화면 구역들: 제목 + 타일 판 (편집 중엔 제목을 눌러 이름 바꾸기) ── -->
            <ItemsControl x:Name="GroupsHost" ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StartGroupViewModel}">
                        <Grid Margin="0,0,48,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- 평소: 제목 글자 -->
                            <TextBlock Text="{Binding Title}" Style="{StaticResource GroupHeader}" Margin="0" VerticalAlignment="Top"
                                       Visibility="{Binding IsEditing, Converter={StaticResource NotVis}}"/>
                            <!-- 편집 중: 제목 버튼 -->
                            <Button Visibility="{Binding IsEditing, Converter={StaticResource Vis}}" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Margin="-8,-6,0,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{DynamicResource TileFill}" Padding="8,4" BorderThickness="2" BorderBrush="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding EditTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                                                <TextBlock Text="{StaticResource Icon.Pencil}" FontFamily="{StaticResource LucideFont}" FontSize="14"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusOuter}"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileFillHover}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource StartTile}" Focusable="False"
                                          ItemContainerStyle="{StaticResource StartTileContainer}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><v:StartPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 편집 중: 여기에 끌어 놓으면 새 구역 -->
            <Border x:Name="NewGroupZone" Width="168" Margin="0,38,0,0" VerticalAlignment="Stretch" BorderThickness="2"
                    BorderBrush="{DynamicResource StrokeStrong}" Background="{DynamicResource TileFill}" Opacity="0.7"
                    Visibility="{Binding IsEditing, Converter={StaticResource Vis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{StaticResource Icon.Plus}" FontFamily="{StaticResource LucideFont}" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="새 구역" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="여기에 끌어 놓기" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <!-- 편집 중 안내 띠 -->
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="48,0,0,8" Padding="14,8" Background="{DynamicResource TileFill}"
            Visibility="{Binding IsEditing, Converter={StaticResource Vis}}" IsHitTestVisible="False">
        <TextBlock Style="{StaticResource Caption}" FontSize="13"
                   Text="끌어서 옮기기 · 다른 타일 가운데에 잠시 대면 폴더 · 구역 제목을 눌러 이름 바꾸기 · 빈 곳을 누르거나 B로 끝"/>
    </Border>

    <!-- ── 폴더 창: 바깥을 누르거나 B로 닫힘 ─────────────────── -->
    <Grid x:Name="FolderLayer" Visibility="{Binding OpenFolder, Converter={StaticResource NullVis}}">
        <Border x:Name="FolderScrim" Background="{DynamicResource Scrim}"/>
        <Border x:Name="FolderCard" Background="{DynamicResource FolderCardFill}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1200" Padding="28,22,28,26"
                KeyboardNavigation.DirectionalNavigation="Contained" m:Entrance.Stagger="Self" m:Entrance.Offset="24">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Style="{StaticResource StatusButton}" Command="{Binding CloseFolderCommand}" ToolTip="닫기"
                            VerticalAlignment="Top">
                        <TextBlock Text="{StaticResource Icon.X}" Style="{StaticResource StatusIcon}" FontSize="20"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource StatusButton}" Command="{Binding StartRenameCommand}" CommandParameter="{Binding OpenFolder}"
                            ToolTip="폴더 이름 바꾸기" VerticalAlignment="Top" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.FolderPen}" Style="{StaticResource StatusIcon}" FontSize="17"/>
                            <TextBlock Text="이름 바꾸기" Style="{StaticResource StatusText}" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Folder}" Style="{StaticResource Icon}" FontSize="26" Margin="0,0,12,0" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="{Binding OpenFolder.Title}" Style="{StaticResource H1}" FontSize="28"/>
                        <TextBlock Style="{StaticResource Caption}" FontSize="15" VerticalAlignment="Bottom" Margin="12,0,0,5">
                            <Run Text="{Binding OpenFolder.CountText, Mode=OneWay}"/><Run Text="개"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="FolderScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                    <ItemsControl x:Name="FolderBoard" ItemsSource="{Binding FolderTiles}" ItemTemplate="{StaticResource StartTile}" Focusable="False"
                                  ItemContainerStyle="{StaticResource StartTileContainer}" Height="{Binding FolderBoardHeight}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><v:StartPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>

    <!-- 폴더·구역 이름 바꾸기 -->
    <Border Visibility="{Binding Renaming, Converter={StaticResource NullVis}}" Background="{DynamicResource Scrim}">
        <Border Style="{StaticResource CardPanel}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18">
            <StackPanel>
                <TextBlock Text="{Binding RenameTitle}" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                <v:InlineEdit x:Name="RenameBox" Text="{Binding RenameText}" FontSize="17" Margin="0,0,0,10" Placeholder="이름 없음"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding FinishRenameCommand}" Content="완료" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>
