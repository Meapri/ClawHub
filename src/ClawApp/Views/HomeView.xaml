<UserControl x:Class="ClawApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <Grid Margin="32,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 게임이 하나도 없을 때 -->
        <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
            <TextBlock Text="아직 게임이 없어요" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
            <TextBlock Text="설정 → 게임 추가에서 실행 파일을 고르거나, Steam·Epic에 설치하면 자동으로 나타납니다."
                       Style="{StaticResource Caption}" Margin="0,10,0,24" HorizontalAlignment="Center"/>
            <Button Style="{StaticResource PrimaryButton}" Content="설정 열기" HorizontalAlignment="Center" local:Nav.InitialFocus="True"
                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <!-- 히어로: 최근 게임 -->
        <Grid Visibility="{Binding IsEmpty, Converter={StaticResource NotVis}}" Margin="0,0,32,0" Height="300">
            <!-- 게임 아트 배너: 테마와 상관없이 아트 위 글자는 흰색 (아래쪽을 어둡게 깔아 가독성 확보) -->
            <Grid>
                <Border CornerRadius="8" Background="{Binding Hero.Placeholder}"/>
                <Border CornerRadius="8" Visibility="{Binding Hero.HasHero, Converter={StaticResource Vis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Hero.Hero}" Stretch="UniformToFill" AlignmentY="Center"/>
                    </Border.Background>
                </Border>
                <Image Source="{Binding Hero.Icon}" Width="96" Height="96" HorizontalAlignment="Right" Margin="0,0,64,0"
                       Visibility="{Binding Hero.HasHero, Converter={StaticResource NotVis}}"/>
                <Border CornerRadius="8" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0.8,0">
                            <GradientStop Color="#E0000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.75"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel VerticalAlignment="Bottom" Margin="32,0,0,28" TextElement.Foreground="White">
                <TextBlock Text="{Binding Hero.LastPlayedLabel}" FontSize="12" Opacity="0.85" Margin="0,0,0,6"/>
                <!-- 로고 아트가 있으면 로고, 없으면 제목 -->
                <Image Source="{Binding Hero.Logo}" MaxWidth="360" MaxHeight="120" HorizontalAlignment="Left" Stretch="Uniform"
                       Visibility="{Binding Hero.HasLogo, Converter={StaticResource Vis}}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Hero.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="SemiBold"
                           MaxWidth="700" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Hero.HasLogo, Converter={StaticResource NotVis}}"/>
                <TextBlock Text="{Binding Hero.ProfileLabel}" FontSize="12" Opacity="0.85" Margin="0,2,0,16"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding Hero.PlayCommand}" local:Nav.InitialFocus="True" Margin="0,0,10,0" MinWidth="140">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,10,0"/><TextBlock Text="플레이"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding Hero.OpenCommand}" Margin="0" Padding="20,10"
                            Background="#33FFFFFF" BorderBrush="#40FFFFFF" Foreground="White">
                        <TextBlock Text="자세히"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 최근/전체 줄 -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource NotVis}}" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Top" Text="최근 플레이" Style="{StaticResource Section}" Margin="2,4,0,0"/>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="-10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource CoverTile}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- 라이브러리 바로가기 타일 -->
                    <Button Style="{StaticResource TileButton}" Width="168" Height="252" Margin="10,10,32,10"
                            Command="{Binding DataContext.OpenLibraryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="라이브러리 전체" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
