<UserControl x:Class="ClawApp.Views.MacroEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             xmlns:m="clr-namespace:ClawApp.Motion"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <UserControl.Resources>
        <ResourceDictionary Source="/ClawApp;component/Themes/KeyPicker.xaml"/>
    </UserControl.Resources>
    <Grid Margin="48,0,40,12">
        <!-- ── 단계 목록 + 선택한 단계 시간 ───────────────── -->
        <Grid Visibility="{Binding IsPickerOpen, Converter={StaticResource NotVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding TotalText}" Style="{StaticResource Caption}" Margin="2,0,0,8"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddStepCommand}" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Plus}" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="단계 추가"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ClearCommand}" Margin="0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Trash2}" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="모두 지우기"/></StackPanel>
                    </Button>
                </StackPanel>
                <Grid>
                    <Border Style="{StaticResource CardPanel}" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" VerticalAlignment="Top" Padding="20">
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="'단계 추가'로 키를 순서대로 넣으세요. 버튼을 한 번 누르면 단계가 차례로 실행돼요. 예: Ctrl(공격) → 50ms → Shift(스킬)"/>
                    </Border>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="4" m:Entrance.Stagger="Items">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavItem}" Height="56" Tag="{Binding IsSelected}"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" GotKeyboardFocus="Step_GotFocus">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" Background="{DynamicResource Accent}" TextElement.Foreground="{DynamicResource AccentText}" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Number}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KeyLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- 선택한 단계 -->
            <StackPanel Grid.Column="1" Margin="20,4,0,0" DataContext="{Binding Selected}" m:Entrance.Key="{Binding Number}" m:Entrance.Offset="24"
                        Visibility="{Binding Converter={StaticResource NullVis}}">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}"><Run Text="단계 "/><Run Text="{Binding Number, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding KeyLabel}" Style="{StaticResource H2}" Margin="0,2,0,10"/>
                        <Button Style="{StaticResource NavButton}" Margin="0"
                                Command="{Binding DataContext.ChangeKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Keyboard}" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="키 바꾸기"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding HoldMs, StringFormat={}{0}ms}" Foreground="{DynamicResource TextDim}"/><TextBlock Text="누르고 있는 시간"/></DockPanel>
                        <Slider Minimum="10" Maximum="2000" SmallChange="50" TickFrequency="10" Value="{Binding HoldMs}"/>
                        <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding GapMs, StringFormat={}{0}ms}" Foreground="{DynamicResource TextDim}"/><TextBlock Text="다음 단계까지 쉬는 시간"/></DockPanel>
                        <Slider Minimum="0" Maximum="2000" SmallChange="50" TickFrequency="10" Value="{Binding GapMs}"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0"
                           Text="매크로는 컨트롤러 펌웨어가 실행해서 진짜 키보드 입력으로 나가요. Y로 15초 동안 실제로 시험해 볼 수 있어요."/>
            </StackPanel>
        </Grid>

        <!-- ── 키 고르기 ─────────────────────────────────── -->
        <DockPanel x:Name="Picker" Visibility="{Binding IsPickerOpen, Converter={StaticResource Vis}}" m:Entrance.Stagger="Self" m:Entrance.Offset="24">
            <TextBlock DockPanel.Dock="Top" Text="이 단계에서 누를 키" Style="{StaticResource Section}" Margin="2,0,0,10"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 매핑 편집과 같은 키보드 모양 판 -->
                    <ItemsControl ItemsSource="{Binding KeyboardRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" Focusable="False" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource KeySlot}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="마우스 · 미디어" Style="{StaticResource Section}" Margin="2,14,0,10"/>
                    <ItemsControl ItemsSource="{Binding ExtraKeys}" Focusable="False" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource KeyTile}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
