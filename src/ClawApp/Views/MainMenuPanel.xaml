<UserControl x:Class="ClawApp.Views.MainMenuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <!-- Windows 11 플라이아웃: Acrylic 틴트 + 8px 모서리 + 얇은 테두리 -->
    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="8">
        <DockPanel Margin="12,20,12,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,20">
                <Image Source="pack://application:,,,/Assets/ClawHub.ico" Width="40" Height="40" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ClawHub" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="MSI Claw 8 EX" Style="{StaticResource Caption}"/>
                </StackPanel>
            </StackPanel>

            <!-- 게임 실행 중일 때만 -->
            <StackPanel DockPanel.Dock="Top" Visibility="{Binding RunningGame, Converter={StaticResource NullVis}}" Margin="0,0,0,12">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ReturnToBackgroundCommand}" local:Nav.InitialFocus="True"
                        Margin="4,0,4,8" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"><Run Text="&#xE768;" FontFamily="{StaticResource IconFont}"/><Run Text="  게임으로 돌아가기"/></TextBlock>
                        <TextBlock Text="{Binding RunningGame.Title}" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Opacity="0.85"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavItem}" Command="{Binding QuitGameCommand}" Foreground="{DynamicResource Danger}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="게임 종료"/></StackPanel>
                </Button>
                <Border Height="1" Background="{DynamicResource Divider}" Margin="8,8"/>
            </StackPanel>

            <!-- 하단: 전원 (시작 메뉴의 전원 단추 자리) -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <UniformGrid Columns="3">
                    <Button Style="{StaticResource NavItem}" Command="{Binding SleepCommand}" HorizontalContentAlignment="Center" Height="56" Padding="0">
                        <StackPanel><TextBlock Text="&#xE708;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/><TextBlock Text="절전" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Command="{Binding RestartCommand}" HorizontalContentAlignment="Center" Height="56" Padding="0">
                        <StackPanel><TextBlock Text="&#xE777;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/><TextBlock Text="다시 시작" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Command="{Binding ShutdownCommand}" HorizontalContentAlignment="Center" Height="56" Padding="0">
                        <StackPanel><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" HorizontalAlignment="Center"/><TextBlock Text="시스템 종료" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    </Button>
                </UniformGrid>
            </Border>

            <ScrollViewer>
                <StackPanel>
                    <Button Style="{StaticResource NavItem}" Command="{Binding GoHomeCommand}" local:Nav.InitialFocus="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="홈"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Command="{Binding OpenLibraryCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="라이브러리"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Command="{Binding OpenProfilesCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="키 매핑"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="설정"/></StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource Divider}" Margin="8,8"/>
                    <Button Style="{StaticResource NavItem}" Command="{Binding OpenXboxAppCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE990;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="Xbox 앱"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Command="{Binding GoToDesktopCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="데스크톱으로"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavItem}" Command="{Binding ExitAppCommand}" Foreground="{DynamicResource TextDim}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="ClawHub 종료"/></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
