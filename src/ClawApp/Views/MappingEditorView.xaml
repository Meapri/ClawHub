<UserControl x:Class="ClawApp.Views.MappingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             xmlns:m="clr-namespace:ClawApp.Motion"
             xmlns:v="clr-namespace:ClawApp.Views"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <Grid Margin="42,-6,40,12">

        <!-- ── 버튼 목록 + 프로필 옵션 ───────────────────── -->
        <Grid Visibility="{Binding IsPickerOpen, Converter={StaticResource NotVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" Margin="6" m:Entrance.Stagger="Items">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButton}" Margin="0,0,8,8" Padding="16,10"
                                    Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <!-- 패드 버튼 그림 (Kenney) -->
                                    <v:ButtonGlyph DockPanel.Dock="Left" Key="{Binding Button}" Width="36" Height="36" Margin="0,0,16,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextWrapping="NoWrap"/>
                                        <TextBlock x:Name="Binding" Text="{Binding BindingText}" FontSize="16" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextDim}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMapped}" Value="True">
                                    <Setter TargetName="Binding" Property="Foreground" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="Binding" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" Margin="14,0,0,0">
                <StackPanel Margin="6" m:Entrance.Stagger="Items">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="프로필 이름 (A를 누르면 키보드)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ProfileName}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="스틱은 펌웨어에서 키로 바꿀 수 없어요. 이동은 D-pad를 방향키로 쓰세요. 조합키는 버튼 하나에 최대 5개."/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource NavButton}" Command="{Binding TestCommand}" IsEnabled="{Binding IsTesting, Converter={x:Static local:InvertBool.Instance}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Timer}" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="15초 테스트 적용"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ToggleModeCommand}">
                        <StackPanel>
                            <TextBlock Text="게임 중 컨트롤러 모드" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ModeText}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" Margin="4,2,0,14"
                               Text="XInput 모드에서 키 출력이 확인됐어요. 스틱을 마우스로 쓰고 싶을 때만 데스크톱 모드로 바꾸세요."/>
                    <Button Style="{StaticResource NavButton}" Command="{Binding DuplicateCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Copy}" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="프로필 복제"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding DeleteCommand}" Foreground="{DynamicResource Danger}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Trash2}" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="프로필 삭제"/></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── 키 선택 (LB/RB 피벗으로 분류 이동) ─────────── -->
        <DockPanel Visibility="{Binding IsPickerOpen, Converter={StaticResource Vis}}" Margin="6,6,6,0" m:Entrance.Stagger="Self">
            <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Padding="20,14" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <v:ButtonGlyph Key="LB" Width="30" Height="30" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource PivotItem}" Foreground="{DynamicResource Text}" FontSize="22"
                                   VerticalAlignment="Center" m:Entrance.Key="{Binding CategoryIndex}" m:Entrance.Offset="24"/>
                        <v:ButtonGlyph Key="RB" Width="30" Height="30" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <v:ButtonGlyph Key="{Binding EditingRow.Button}" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding EditingRow.Name, Mode=OneWay}"/><Run Text=" 버튼을 누르면"/></TextBlock>
                            <TextBlock Text="{Binding ComboText}" Style="{StaticResource H2}" FontSize="24" Foreground="{DynamicResource Accent}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Command="{Binding OpenMacroCommand}" HorizontalAlignment="Left"
                    Visibility="{Binding EditingIsMKey, Converter={StaticResource Vis}}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Timer}" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                    <TextBlock Text="시간 매크로로 만들기 (키를 순서대로·시간 지정)"/>
                </StackPanel>
            </Button>
            <ScrollViewer Margin="-6,0,-6,0">
                <ItemsControl ItemsSource="{Binding Keys}" Focusable="False" Margin="6" m:Entrance.Stagger="Items" m:Entrance.Key="{Binding CategoryIndex}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Chip}" MinWidth="64" Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                          Command="{Binding DataContext.ToggleKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}" local:Nav.InitialFocus="True"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
