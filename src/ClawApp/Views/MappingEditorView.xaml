<UserControl x:Class="ClawApp.Views.MappingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             xmlns:m="clr-namespace:ClawApp.Motion"
             xmlns:v="clr-namespace:ClawApp.Views"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <!--
        매핑 편집: 위 = 프로필 줄, 가운데 = 본체 사진, 둘레 = 버튼 카드 (안내선으로 사진 속 버튼과 이어짐), 옵션은 오른쪽 패널.
        버튼을 고르면 실제 키보드 모양 선택판이 열리고, 키를 한 번 누르면 지정된 뒤 돌아온다.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/ClawApp;component/Themes/KeyPicker.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- 지정된 키 표시 (줄 안의 작은 키캡). 두 번째부터 앞에 "+" -->
        <DataTemplate x:Key="KeycapLabel">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="+" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"
                           Visibility="{Binding ShowPlus, Converter={StaticResource Vis}}"/>
                <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1,1,1,3" Background="{DynamicResource TileFill}"
                        Padding="8,1,8,0" MinWidth="28">
                    <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </DataTemplate>


        <!-- 버튼 줄 내용: 이름 + 키캡 (없으면 "게임패드 그대로", 매크로면 단계 수) -->
        <DataTemplate x:Key="RowBody">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Name" Text="{Binding Name}" Style="{StaticResource Caption}" TextWrapping="NoWrap"/>
                <Grid Margin="0,4,0,0" x:Name="Body">
                    <ItemsControl ItemsSource="{Binding KeyLabels}" AlternationCount="8" Focusable="False" ItemsPanel="{StaticResource Row}"
                                  ItemTemplate="{StaticResource KeycapLabel}" m:Entrance.Key="{Binding Version}" m:Entrance.Offset="16"/>
                    <TextBlock Text="게임패드 그대로" FontSize="15" Foreground="{DynamicResource TextDim}"
                               Visibility="{Binding IsMapped, Converter={StaticResource NotVis}}"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsMacro, Converter={StaticResource Vis}}">
                        <TextBlock Text="{StaticResource Icon.Timer}" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
                <!-- 고급 동작 (길게 · 두 번 · 연사 · 토글 · 레이어 · 원형 메뉴) -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding Advanced, Converter={StaticResource NullVis}}">
                    <TextBlock Text="{StaticResource Icon.Layers}" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Advanced}" FontSize="12" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                </StackPanel>
                <!-- 다른 버튼과 같은 키를 내면 게임에서 구분이 안 된다 -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding Conflict, Converter={StaticResource NullVis}}">
                    <TextBlock Text="{StaticResource Icon.TriangleAlert}" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Warn}" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Conflict}" FontSize="12" Foreground="{DynamicResource Warn}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 오른손 줄: [그림] 이름/키 -->
        <DataTemplate x:Key="RightRow">
            <Grid x:Name="Root">
                <Button Style="{StaticResource NavButton}" Padding="0" MinHeight="56" Margin="0,0,0,4" HorizontalContentAlignment="Stretch"
                        local:Nav.InitialFocus="{Binding IsFirst}"
                        Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Border x:Name="Live" Padding="14,6" Background="Transparent" BorderBrush="{DynamicResource Accent}">
                        <DockPanel>
                            <v:ButtonGlyph x:Name="Glyph" DockPanel.Dock="Left" Key="{Binding Button}" Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowBody}"/>
                        </DockPanel>
                    </Border>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <!-- 키가 지정된 줄: 컨트롤러 쪽 가장자리에 강조색 막대 -->
                <DataTrigger Binding="{Binding IsMapped}" Value="True">
                    <Setter TargetName="Live" Property="BorderThickness" Value="4,0,0,0"/>
                    <Setter TargetName="Live" Property="Padding" Value="10,6,14,6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupStart}" Value="True"><Setter TargetName="Root" Property="Margin" Value="0,8,0,0"/></DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Live" Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Live" Property="TextElement.Foreground" Value="{DynamicResource AccentText}"/>
                    <Setter TargetName="Glyph" Property="Tint" Value="{DynamicResource AccentText}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 왼손 줄: 이름/키 [그림] — 컨트롤러 쪽으로 그림이 오게 오른쪽 정렬 -->
        <DataTemplate x:Key="LeftRow">
            <Grid x:Name="Root">
                <Button Style="{StaticResource NavButton}" Padding="0" MinHeight="56" Margin="0,0,0,4" HorizontalContentAlignment="Stretch"
                        local:Nav.InitialFocus="{Binding IsFirst}"
                        Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Border x:Name="Live" Padding="14,6" Background="Transparent" BorderBrush="{DynamicResource Accent}">
                        <DockPanel>
                            <v:ButtonGlyph x:Name="Glyph" DockPanel.Dock="Right" Key="{Binding Button}" Width="34" Height="34" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowBody}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMapped}" Value="True">
                    <Setter TargetName="Live" Property="BorderThickness" Value="0,0,4,0"/>
                    <Setter TargetName="Live" Property="Padding" Value="14,6,10,6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupStart}" Value="True"><Setter TargetName="Root" Property="Margin" Value="0,8,0,0"/></DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="Live" Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Live" Property="TextElement.Foreground" Value="{DynamicResource AccentText}"/>
                    <Setter TargetName="Glyph" Property="Tint" Value="{DynamicResource AccentText}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 가운데 열의 작은 동작 버튼 -->
        <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
                    <ItemsPanelTemplate x:Key="ChipWrap"><WrapPanel/></ItemsPanelTemplate>
                    <!-- 값 슬라이더 한 줄: 이름 · 막대 · 값 -->
                    <Style x:Key="TuneLabel" TargetType="TextBlock">
                        <Setter Property="Width" Value="96"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                    </Style>
                    <Style x:Key="TuneValue" TargetType="TextBlock">
                        <Setter Property="DockPanel.Dock" Value="Right"/>
                        <Setter Property="Width" Value="44"/>
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="42,-6,40,12">

        <!-- ══ 버튼 배치 화면 ══════════════════════════════════════════════
             위 = 프로필·동작 줄, 가운데 = 본체 사진(전체), 둘레 = 버튼 카드. 카드에서 사진 속 실제 버튼까지 안내선이 이어지고
             고른 카드의 선·버튼은 강조색으로 밝다 (Steam Input·Armoury Crate식). 카드 순서는 본체 위→아래라 선이 엇갈리지 않는다. -->
        <Grid x:Name="Board" Visibility="{Binding IsPickerOpen, Converter={StaticResource NotVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- 프로필 줄: 이름·요약 | 눌러서 찾기 · 되돌리기 · 테스트 · 옵션 -->
            <DockPanel Grid.ColumnSpan="3" Margin="6,0,6,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallAction}" Command="{Binding ToggleListenCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsTesting, Converter={StaticResource NotVis}}">
                        <StackPanel Orientation="Horizontal">
                            <v:ButtonGlyph Key="RB" Width="24" Height="24" Margin="0,0,8,0"/>
                            <TextBlock Text="눌러서 찾기" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallAction}" Command="{Binding UndoCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsTesting, Converter={StaticResource NotVis}}">
                        <StackPanel Orientation="Horizontal">
                            <v:ButtonGlyph Key="LB" Width="24" Height="24" Margin="0,0,8,0"/>
                            <TextBlock Text="되돌리기" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- 테스트 (테스트 중에도 터치로 끌 수 있게 입력 가로채기에서 뺀다) -->
                    <Button Uid="CaptureBypass" Style="{StaticResource PrimaryButton}" Command="{Binding StartOrStopTestCommand}" Margin="0,0,8,0" Padding="20,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTesting, Converter={StaticResource NotVis}}">
                                <v:ButtonGlyph Key="Y" Width="24" Height="24" Margin="0,0,10,0"/>
                                <TextBlock Text="15초 동안 써 보기" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTesting, Converter={StaticResource Vis}}">
                                <TextBlock Text="{StaticResource Icon.Square}" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                <TextBlock VerticalAlignment="Center"><Run Text="테스트 끝내기 · "/><Run Text="{Binding TestSecondsLeft, Mode=OneWay}"/><Run Text="초"/></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <!-- 스틱·트리거·자이로 (펌웨어 조정): 지금 상태 요약을 함께 보여 준다 -->
                    <Button x:Name="TuningButton" Style="{StaticResource SmallAction}" Command="{Binding ToggleTuningCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsTesting, Converter={StaticResource NotVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Gamepad2}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="스틱·자이로" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TuningSummary}" Style="{StaticResource Caption}" FontSize="11" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OptionsButton" Style="{StaticResource SmallAction}" Command="{Binding ToggleOptionsCommand}" Margin="0"
                            Visibility="{Binding IsTesting, Converter={StaticResource NotVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.SlidersHorizontal}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="옵션" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0">
                    <!-- 이름: 평소엔 버튼(지나가도 터치 키보드가 뜨지 않게), A를 누르면 입력칸 -->
                    <v:InlineEdit Text="{Binding ProfileName}" FontSize="18" FontWeight="SemiBold" InnerPadding="14,8" MinWidth="320"
                                  IsEnabled="{Binding CanEditName}"/>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" Margin="2,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- 왼손 카드 -->
            <ItemsControl x:Name="LeftList" Grid.Row="1" ItemsSource="{Binding LeftRows}" ItemTemplate="{StaticResource LeftRow}" Focusable="False"
                          VerticalAlignment="Center" Margin="6,0,0,0" m:Entrance.Stagger="Items" m:Entrance.Offset="-32"/>

            <!-- 가운데: 본체 사진 (전체). 사진의 버튼을 눌러도 편집 -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="28,0">
                <v:ControllerMap x:Name="Map" Height="320" VerticalAlignment="Center" ZoomToFocus="False"
                                 Rows="{Binding Rows}" Focused="{Binding FocusedButton}" EditCommand="{Binding EditButtonCommand}"
                                 m:Entrance.Stagger="Self" m:Entrance.Offset="0"/>
                <!-- 눌러서 찾기: 다음에 누른 버튼을 연다 -->
                <Border Background="{DynamicResource Bg1}" Padding="20,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,3"
                        m:Reveal.IsShown="{Binding IsListening}" m:Reveal.EnterY="8" m:Reveal.ExitY="6">
                    <StackPanel>
                        <TextBlock Text="바꿀 버튼을 누르세요" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="6초 안에 · M1·M2는 카드에서 골라요" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <!-- 테스트 중: 실제로 나온 키 (최근 것이 위). 버튼 카드와 사진의 그 버튼이 함께 켜진다 -->
                <Border Style="{StaticResource CardPanel}" VerticalAlignment="Bottom" HorizontalAlignment="Center" MinWidth="320" Margin="0,0,0,4"
                        m:Reveal.IsShown="{Binding IsTesting}" m:Reveal.EnterY="16" m:Reveal.ExitY="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="컨트롤러 버튼을 눌러 보세요 · 나온 키가 여기에 쌓여요"/>
                        <TextBlock Text="아직 입력 없음" Foreground="{DynamicResource TextDim}"
                                   Visibility="{Binding HasTestLog, Converter={StaticResource NotVis}}"/>
                        <ItemsControl ItemsSource="{Binding TestLog}" Focusable="False" MaxHeight="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6" m:Entrance.Stagger="Self" m:Entrance.Offset="-16">
                                        <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource Accent}" BorderThickness="1,1,1,3" Padding="8,1,8,0" MinWidth="28"
                                                Background="{DynamicResource TileFill}">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}" FontSize="14">
                                            <Run Text="← "/><Run Text="{Binding Button, Mode=OneWay, TargetNullValue=지정 안 된 키}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 오른손 카드 -->
            <ItemsControl x:Name="RightList" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding RightRows}" ItemTemplate="{StaticResource RightRow}" Focusable="False"
                          VerticalAlignment="Center" Margin="0,0,6,0" m:Entrance.Stagger="Items" m:Entrance.Offset="32"/>

            <!-- 안내선 (코드가 그린다: MappingEditorView.DrawLeaders) -->
            <Canvas x:Name="Leaders" Grid.Row="1" Grid.ColumnSpan="3" IsHitTestVisible="False"/>

            <!-- ══ 스틱·트리거·자이로 (펌웨어 조정 — 드라이버·소프트웨어 입력 없음, Xbox Ally의 Armoury Crate와 같은 방식) ══ -->
            <Border x:Name="TuningPanel" Grid.RowSpan="2" Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="460" Margin="0,-4,0,0"
                    Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0"
                    KeyboardNavigation.DirectionalNavigation="Contained" DataContext="{Binding Tuning}"
                    m:Reveal.IsShown="{Binding DataContext.IsTuningOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    m:Reveal.ExitX="48" m:Entrance.Stagger="Self" m:Entrance.Offset="48">
                <!-- 처음 열 때 만든다 (편집기 열기를 가볍게) -->
                <v:LazyContent><DataTemplate>
                <ScrollViewer Padding="16,12,16,6">
                    <StackPanel Margin="6"> <!-- 포커스 테두리(바깥 4px)가 스크롤 가장자리에서 잘리지 않게 -->
                        <TextBlock Text="스틱·트리거·자이로" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                   Text="컨트롤러 펌웨어가 처리해서 안티치트 걱정이 없고 지연도 없어요. 이 프로필이 적용될 때만 쓰여요."/>

                        <!-- 자이로 -->
                        <TextBlock Text="자이로 조준" Style="{StaticResource Section}" Margin="2,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding GyroOutputs}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <v:ChoiceChip Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding DataContext.PickGyroOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel m:Reveal.IsShown="{Binding GyroOn}" m:Reveal.Kind="Inline">
                            <TextBlock Text="켜는 버튼" Style="{StaticResource Caption}" Margin="2,6,0,6"/>
                            <ItemsControl ItemsSource="{Binding GyroButtons}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <v:ChoiceChip Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.PickGyroButtonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding GyroActivations}" Focusable="False" ItemsPanel="{StaticResource ChipWrap}"
                                          m:Reveal.IsShown="{Binding GyroHasButton}" m:Reveal.Kind="Inline">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <v:ChoiceChip Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.PickGyroActivationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="감도" Style="{StaticResource TuneLabel}"/>
                                <TextBlock Text="{Binding GyroSensitivity, StringFormat={}{0}%}" Style="{StaticResource TuneValue}"/>
                                <Slider Minimum="1" Maximum="100" SmallChange="5" Value="{Binding GyroSensitivity}"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="데드존" Style="{StaticResource TuneLabel}"/>
                                <TextBlock Text="{Binding GyroDeadzone, StringFormat={}{0}%}" Style="{StaticResource TuneValue}"/>
                                <Slider Minimum="0" Maximum="50" SmallChange="2" Value="{Binding GyroDeadzone}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0"
                                       Text="오른쪽 스틱으로 보내면 게임패드를 지원하는 게임 대부분에서 바로 조준에 쓸 수 있어요. 켜는 버튼의 원래 동작은 그대로예요."/>
                        </StackPanel>

                        <!-- 스틱 -->
                        <DockPanel Margin="2,18,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallAction}" Command="{Binding ResetSticksCommand}" Margin="0" Padding="12,4" MinHeight="34" FontSize="14"
                                    Content="기본값으로"/>
                            <TextBlock Text="스틱" Style="{StaticResource Section}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="왼쪽 안쪽" Style="{StaticResource TuneLabel}"/>
                            <TextBlock Text="{Binding LeftInner}" Style="{StaticResource TuneValue}"/>
                            <Slider Minimum="0" Maximum="30" SmallChange="1" Value="{Binding LeftInner}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="왼쪽 바깥" Style="{StaticResource TuneLabel}"/>
                            <TextBlock Text="{Binding LeftOuter}" Style="{StaticResource TuneValue}"/>
                            <Slider Minimum="70" Maximum="100" SmallChange="1" Value="{Binding LeftOuter}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="오른쪽 안쪽" Style="{StaticResource TuneLabel}"/>
                            <TextBlock Text="{Binding RightInner}" Style="{StaticResource TuneValue}"/>
                            <Slider Minimum="0" Maximum="30" SmallChange="1" Value="{Binding RightInner}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="오른쪽 바깥" Style="{StaticResource TuneLabel}"/>
                            <TextBlock Text="{Binding RightOuter}" Style="{StaticResource TuneValue}"/>
                            <Slider Minimum="70" Maximum="100" SmallChange="1" Value="{Binding RightOuter}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="2,2,0,8"
                                   Text="안쪽 = 이만큼은 움직여도 무시 (쏠림 방지) · 바깥 = 이만큼 기울이면 끝까지 기울인 것으로 (100 = 끔)"/>
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SwapSticks}">
                            <StackPanel>
                                <TextBlock Text="왼쪽·오른쪽 스틱 바꾸기"/>
                                <TextBlock Text="이동과 시점을 반대 스틱으로" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- 트리거 -->
                        <TextBlock Text="트리거" Style="{StaticResource Section}" Margin="2,14,0,8"/>
                        <DockPanel>
                            <TextBlock Text="LT 안쪽" Style="{StaticResource TuneLabel}"/>
                            <TextBlock Text="{Binding LtInner}" Style="{StaticResource TuneValue}"/>
                            <Slider Minimum="0" Maximum="40" SmallChange="1" Value="{Binding LtInner}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="LT 바깥" Style="{StaticResource TuneLabel}"/>
                            <TextBlock Text="{Binding LtOuter}" Style="{StaticResource TuneValue}"/>
                            <Slider Minimum="60" Maximum="100" SmallChange="1" Value="{Binding LtOuter}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="RT 안쪽" Style="{StaticResource TuneLabel}"/>
                            <TextBlock Text="{Binding RtInner}" Style="{StaticResource TuneValue}"/>
                            <Slider Minimum="0" Maximum="40" SmallChange="1" Value="{Binding RtInner}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="RT 바깥" Style="{StaticResource TuneLabel}"/>
                            <TextBlock Text="{Binding RtOuter}" Style="{StaticResource TuneValue}"/>
                            <Slider Minimum="60" Maximum="100" SmallChange="1" Value="{Binding RtOuter}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="2,2,0,0"
                                   Text="바깥 값을 낮추면 조금만 당겨도 끝까지 당긴 것이 돼요 (사격 게임에서 빠르게)."/>
                    </StackPanel>
                </ScrollViewer>
                </DataTemplate></v:LazyContent>
            </Border>

            <!-- ══ 프로필 옵션 (오른쪽에서 미끄러져 나오는 패널) ══ -->
            <Border x:Name="OptionsPanel" Grid.RowSpan="2" Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="400" Margin="0,-4,0,0"
                    Background="{DynamicResource Bg0}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    m:Reveal.IsShown="{Binding IsOptionsOpen}" m:Reveal.ExitX="48" m:Entrance.Stagger="Self" m:Entrance.Offset="48">
                <!-- 처음 열 때 만든다 (편집기 열기를 가볍게) -->
                <v:LazyContent><DataTemplate>
                <ScrollViewer Padding="16,12,16,6">
                    <StackPanel Margin="6">
                        <TextBlock Text="프로필 옵션" Style="{StaticResource H2}" Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding ModeTitle}" Style="{StaticResource Section}" Margin="2,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Command="{Binding ToggleModeCommand}" HorizontalContentAlignment="Stretch">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="A로 변경" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModeText}" FontSize="18" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Button>

                        <!-- 고급 입력 (2단계 · 소프트웨어): 켜야 선택판에 '언제' 칩이 생긴다 -->
                        <TextBlock Text="고급 입력" Style="{StaticResource Section}" Margin="2,14,0,8"/>
                        <v:ChoiceChip Style="{StaticResource Switch}" IsChecked="{Binding AdvancedEnabled, Mode=OneWay}" Command="{Binding ToggleAdvancedCommand}">
                            <StackPanel>
                                <TextBlock Text="길게·두 번·연사·토글·레이어·원형 메뉴" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Steam Input처럼 버튼 하나에 여러 동작. 소프트웨어 입력이라 일부 온라인 게임 안티치트와 맞지 않을 수 있어요."/>
                            </StackPanel>
                        </v:ChoiceChip>

                        <!-- 3단계 가상 패드 (ViGEmBus·HidHide) -->
                        <v:ChoiceChip Style="{StaticResource Switch}" IsChecked="{Binding VirtualPadOn, Mode=OneWay}" Command="{Binding ToggleVirtualPadCommand}" Margin="0,2,0,4">
                            <StackPanel>
                                <TextBlock Text="가상 패드" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="게임에는 ClawHub가 만든 Xbox 패드를 보여 줘요. 고급 동작에서 게임패드 버튼을 내고, 아래 스틱 바꾸기에서 실제 스틱 움직임을 게임에서 숨겨요."/>
                                <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}" Margin="0,2,0,0" Text="드라이버(ViGEmBus·HidHide)가 설치돼 있지 않아요"
                                           Visibility="{Binding VirtualPadDrivers, Converter={StaticResource NotVis}}"/>
                            </StackPanel>
                        </v:ChoiceChip>

                        <!-- 스틱 → 키·마우스: XInput 모드 프로필이면 가상 패드 없이도 (게임도 실제 스틱을 같이 본다) -->
                        <StackPanel Visibility="{Binding IsXInputMode, Converter={StaticResource Vis}}">
                            <TextBlock Text="스틱" Style="{StaticResource Section}" Margin="2,14,0,2"/>
                            <TextBlock Text="{Binding StickNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,8"/>
                            <TextBlock Text="왼쪽 스틱" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding LeftStickChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <v:ChoiceChip Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.PickLeftStickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="오른쪽 스틱" Style="{StaticResource Caption}" Margin="2,8,0,6"/>
                            <ItemsControl ItemsSource="{Binding RightStickChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <v:ChoiceChip Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.PickRightStickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,8,0,0" m:Reveal.IsShown="{Binding UsesStickMouse}" m:Reveal.Kind="Inline">
                                <TextBlock Text="마우스 속도" Width="96" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MouseSpeed}" Width="36" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Slider Minimum="5" Maximum="100" SmallChange="5" Value="{Binding MouseSpeed}"/>
                            </DockPanel>
                        </StackPanel>

                        <TextBlock Text="빠른 채우기" Style="{StaticResource Section}" Margin="2,14,0,8"/>
                        <WrapPanel>
                            <Button Style="{StaticResource SmallAction}" Command="{Binding FillDpadCommand}" CommandParameter="arrows">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Move}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="방향 = 방향키"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallAction}" Command="{Binding FillDpadCommand}" CommandParameter="wasd">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Move}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="방향 = WASD"/></StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="프리셋으로 덮어쓰기" Style="{StaticResource Section}" Margin="2,10,0,8"/>
                        <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NavButton}" Content="{Binding Name}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="프로필" Style="{StaticResource Section}" Margin="2,14,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource SmallAction}" Command="{Binding DuplicateCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Copy}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="복제"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmallAction}" Command="{Binding DeleteCommand}" Foreground="{DynamicResource Danger}" Margin="0,0,0,8"
                                    Visibility="{Binding CanDelete, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Trash2}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="삭제"/></StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0"
                                   Text="스틱은 펌웨어에서 키로 바꿀 수 없어요 — 이동은 방향 버튼을 쓰세요. 매핑은 컨트롤러 펌웨어가 처리해서 게임에는 진짜 키보드 입력으로 보여요."/>
                    </StackPanel>
                </ScrollViewer>
                </DataTemplate></v:LazyContent>
            </Border>
        </Grid>

        <!-- ══ 키 선택판 ══════════════════════════════════════ -->
        <!-- 처음 열 때 만든다 (키보드 판 ~110개 키 — 편집기를 열 때마다 미리 만들어 0.4초 늦었다) -->
        <v:LazyContent x:Name="Picker" Visibility="{Binding IsPickerOpen, Converter={StaticResource Vis}}" Margin="6,4,6,0" m:Entrance.Stagger="Self" m:Entrance.Offset="24"><DataTemplate>
        <DockPanel>
            <!-- 머리: 어떤 버튼 → 지금 무엇 + 모드·지우기 -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Padding="18,12" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallAction}" Command="{Binding OpenMacroCommand}" Margin="0,0,8,0"
                                Visibility="{Binding EditingIsMKey, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Timer}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="시간 매크로"/></StackPanel>
                        </Button>
                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding MultiKey}" Margin="0,0,8,0" Focusable="False">
                            <StackPanel Orientation="Horizontal">
                                <v:ButtonGlyph Key="Y" Width="24" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="여러 키 자유 조합" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button Style="{StaticResource SmallAction}" Command="{Binding ClearEditingCommand}" Margin="0" Focusable="False">
                            <StackPanel Orientation="Horizontal">
                                <v:ButtonGlyph Key="X" Width="24" Height="24" Margin="0,0,8,0"/>
                                <TextBlock Text="게임패드 그대로" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- 본체 사진이 전체에서 이 버튼으로 다가간다 (선택판을 열 때마다) -->
                    <v:ControllerMap DockPanel.Dock="Left" Width="300" Height="120" Margin="0,0,24,0" VerticalAlignment="Center" ShowCaption="False"
                                     Rows="{Binding Rows}" Focused="{Binding EditingRow.Button}" ZoomToFocus="True"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding EditingSlotCaption}"/>
                        <Grid Margin="0,4,0,0">
                            <ItemsControl ItemsSource="{Binding EditingKeyLabels}" AlternationCount="8" Focusable="False" ItemsPanel="{StaticResource Row}"
                                          ItemTemplate="{StaticResource KeycapLabel}" TextElement.FontSize="18"/>
                            <TextBlock Text="{Binding EditingEmptyText}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"
                                       Visibility="{Binding EditingHasKeys, Converter={StaticResource NotVis}}"/>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 여러 키를 넣은 버튼: 동시에(펌웨어) / 차례로(키마다 간격만큼 누르고 있다가 다음 키 — 스킬 딜레이가 길어도 씹히지 않게) -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Padding="18,10" Margin="0,0,0,12"
                    Visibility="{Binding CanSequence, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="여러 키 누르는 방식" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0"/>
                        <v:ChoiceChip Style="{StaticResource Chip}" Content="동시에" IsChecked="{Binding SequenceOff, Mode=OneWay}"
                                      Command="{Binding SetSequenceCommand}" CommandParameter="chord"/>
                        <v:ChoiceChip Style="{StaticResource Chip}" Content="차례로" IsChecked="{Binding SequenceOn, Mode=OneWay}"
                                      Command="{Binding SetSequenceCommand}" CommandParameter="sequence"/>
                    </DockPanel>
                    <!-- 차례로: 버튼을 누르고 있는 동안 (트리거는 기본 '누르는 동안 반복') -->
                    <ItemsControl ItemsSource="{Binding SequenceModeChoices}" Focusable="False" Margin="0,8,0,0"
                                  Visibility="{Binding SequenceOn, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <v:ChoiceChip Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding DataContext.PickSequenceModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 차례로: 키마다 누르고 있을 시간 (딜레이가 긴 스킬만 길게) -->
                    <ItemsControl ItemsSource="{Binding SequenceSteps}" Focusable="False" Margin="0,8,0,0"
                                  Visibility="{Binding SequenceOn, Converter={StaticResource Vis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding Label}" Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Width="56" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Slider Minimum="100" Maximum="3000" SmallChange="50" LargeChange="100" Value="{Binding Ms}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,6,0,0"
                               Text="차례로: 키를 하나씩, 정한 시간만큼 누르고 있다가 다음 키로 넘어가요. 딜레이가 긴 스킬은 그 키의 시간만 딜레이보다 조금 길게 주세요. 누르는 동안 반복: 누르고 있으면 처음부터 되풀이하고, 떼면 바로 멈춰요 (트리거 기본)."/>
                    <TextBlock Text="{Binding SequenceConflictNote}" Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="2,4,0,0"
                               Visibility="{Binding SequenceConflictNote, Converter={StaticResource NullVis}}"/>
                </StackPanel>
            </Border>

            <!-- 고급 입력: 언제 낼 키인지 (칩) + 이 버튼의 동작 스위치. 프로필에서 고급 입력을 켰을 때만 -->
            <DockPanel x:Name="AdvancedStrip" DockPanel.Dock="Top" Margin="0,-2,0,14"
                       m:Reveal.IsShown="{Binding AdvancedEnabled}" m:Reveal.Kind="Inline">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="{Binding EditingTurbo, Mode=OneWay}" Command="{Binding CycleTurboCommand}"
                                  Content="{Binding TurboText}" Margin="0,0,6,0"/>
                    <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="{Binding EditingToggle, Mode=OneWay}" Command="{Binding ToggleToggleCommand}"
                                  Content="토글" Margin="0,0,6,0"/>
                    <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="{Binding EditingLayerShift, Mode=OneWay}" Command="{Binding ToggleLayerShiftCommand}"
                                  Content="레이어 버튼" Margin="0,0,6,0"/>
                    <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="{Binding EditingRadial, Mode=OneWay}" Command="{Binding ToggleRadialCommand}"
                                  Content="원형 메뉴" Margin="0"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Slots}" Focusable="False" ItemsPanel="{StaticResource Row}" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=OneWay}" Margin="0,0,6,0" MinWidth="72"
                                          Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Keys}" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </v:ChoiceChip>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- 원형 메뉴 옵션: 칸 수 · 고르는 스틱 · 크기 · 진동 · 미리 보기, 고른 칸의 이름 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,-6,0,14" m:Reveal.IsShown="{Binding EditingRadial}" m:Reveal.Kind="Inline">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="False" Command="{Binding CycleRadialCountCommand}" Content="{Binding RadialCountText}" Margin="0,0,6,0"/>
                    <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="False" Command="{Binding ToggleRadialStickCommand}" Content="{Binding RadialStickText}" Margin="0,0,6,0"/>
                    <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="False" Command="{Binding CycleRadialSizeCommand}" Content="{Binding RadialSizeText}" Margin="0,0,6,0"/>
                    <v:ChoiceChip Style="{StaticResource Chip}" IsChecked="{Binding RadialHaptics, Mode=OneWay}" Command="{Binding ToggleRadialHapticsCommand}" Content="진동" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource SmallAction}" Command="{Binding PreviewRadialCommand}" Margin="0" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Eye}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="미리 보기" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsRadialSlot, Converter={StaticResource Vis}}">
                    <TextBlock Text="칸 이름" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <v:InlineEdit Text="{Binding EditingSliceLabel}" Width="240" FontSize="15" InnerPadding="12,6" Placeholder="비우면 키 이름"/>
                </StackPanel>
            </DockPanel>

            <!-- 탭 (LB/RB) -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <v:ButtonGlyph DockPanel.Dock="Left" Key="LB" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" ItemsPanel="{StaticResource Row}" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Focusable="False" Cursor="Hand" Margin="0,0,26,0"
                                    Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Background="Transparent">
                                            <StackPanel Orientation="Horizontal" x:Name="Label" TextElement.Foreground="{DynamicResource PivotDim}">
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <Border x:Name="Bar" Height="3" Margin="0,6,0,0" Background="{DynamicResource Accent}" Visibility="Hidden"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Text}"/>
                                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <v:ButtonGlyph Key="RB" Width="28" Height="28" Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </DockPanel>

            <Grid x:Name="PickerContent">
                <!-- 키보드 -->
                <v:LazyContent Visibility="{Binding CategoryIndex, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=0}"><DataTemplate>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="함께 누를 키" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ItemsControl ItemsSource="{Binding Modifiers}" Focusable="False" ItemsPanel="{StaticResource Row}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource KeycapButton}" Tag="{Binding IsOn}" Width="76" Height="44" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ToggleModifierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="켜 두고 아래에서 키를 고르면 Ctrl + Q처럼 조합돼요. 작은 글자는 이미 그 키를 쓰는 버튼이에요."/>
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="-6"> <!-- 막대는 숨기고 스크롤만 (패드 포커스·터치) -->
                        <ItemsControl ItemsSource="{Binding KeyboardRows}" Focusable="False" Margin="6" m:Entrance.Stagger="Items" m:Entrance.Offset="24">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}" Focusable="False" ItemsPanel="{StaticResource Row}" ItemTemplate="{StaticResource KeySlot}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
                </DataTemplate></v:LazyContent>

                <!-- 마우스 -->
                <v:LazyContent Visibility="{Binding CategoryIndex, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=1}"><DataTemplate>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding MouseKeys}" Focusable="False" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource KeyTile}"
                                  m:Entrance.Stagger="Items" m:Entrance.Offset="24"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0"
                               Text="스틱으로 마우스 커서를 움직이려면 이 프로필의 '게임 중 컨트롤러 모드'를 데스크톱으로 바꾸세요."/>
                </StackPanel>
                </DataTemplate></v:LazyContent>

                <!-- 조합·미디어 -->
                <v:LazyContent Visibility="{Binding CategoryIndex, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=2}"><DataTemplate>
                <ScrollViewer Margin="-6">
                    <StackPanel Margin="6">
                        <TextBlock Text="자주 쓰는 조합" Style="{StaticResource Section}" Margin="2,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ComboPresets}" Focusable="False" ItemsPanel="{StaticResource Wrap}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource KeycapButton}" Tag="{Binding IsSelected}" Height="52" Padding="0" Margin="0,0,8,8" MinWidth="150"
                                            Command="{Binding DataContext.ApplyComboCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Label}" Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="미디어" Style="{StaticResource Section}" Margin="2,12,0,10"/>
                        <ItemsControl ItemsSource="{Binding MediaKeys}" Focusable="False" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource KeyTile}"/>
                    </StackPanel>
                </ScrollViewer>
                </DataTemplate></v:LazyContent>

                <!-- 게임패드 -->
                <v:LazyContent Visibility="{Binding CategoryIndex, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=3}"><DataTemplate>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,10"
                               Text="다른 패드 버튼처럼 동작하게 해요. 예: 뒷면 M1 = A (엄지를 떼지 않고 점프)."/>
                    <ItemsControl ItemsSource="{Binding GamepadKeys}" Focusable="False" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource KeyTile}"
                                  m:Entrance.Stagger="Items" m:Entrance.Offset="24"/>
                </StackPanel>
                </DataTemplate></v:LazyContent>

                <!-- 시스템 동작 (ClawHub가 처리 — 게임 입력이 아니라 안티치트와 상관없음) -->
                <v:LazyContent Visibility="{Binding CategoryIndex, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=4}"><DataTemplate>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,10" TextWrapping="Wrap"
                               Text="게임 중에도 버튼 하나로 마이크를 끄거나 스크린샷을 찍어요. 누르면 화면 위에 결과가 잠깐 떠요."/>
                    <ItemsControl ItemsSource="{Binding SystemKeys}" Focusable="False" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource KeyTile}"
                                  m:Entrance.Stagger="Items" m:Entrance.Offset="24"/>
                </StackPanel>
                </DataTemplate></v:LazyContent>
            </Grid>
        </DockPanel>
        </DataTemplate></v:LazyContent>
    </Grid>
</UserControl>
