<UserControl x:Class="ClawApp.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:ClawApp.Motion"
             xmlns:v="clr-namespace:ClawApp.Views"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <!-- 프로필 목록: 이름 · 요약 · 쓰는 게임 + 주요 버튼 미리보기 -->
    <!-- 줄 폭은 최대 900, 왼쪽 48에 붙인다 (MaxWidth만 주면 가운데로 가 버림) -->
    <ScrollViewer Margin="42,-6,40,12">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="912"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="6">
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" m:Entrance.Stagger="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NavButton}" HorizontalContentAlignment="Stretch" Padding="20,14"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Keyboard}" Style="{StaticResource Icon}" FontSize="24"
                                           VerticalAlignment="Top" Margin="0,2,18,0" Foreground="{DynamicResource Accent}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}"
                                           Foreground="{DynamicResource TextDim}" Margin="16,0,0,0"/>
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding InUse, Converter={StaticResource Vis}}">
                                            <TextBlock Text="사용 중" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Profile.Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                        <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding UsedBy, Mode=OneWay}"/>
                                    </TextBlock>
                                    <!-- 주요 버튼 미리보기: [A] Space  [X] Z ... -->
                                    <ItemsControl ItemsSource="{Binding Preview}" Focusable="False" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                                    <v:ButtonGlyph Key="{Binding Button}" Width="24" Height="24" Margin="0,0,6,0"/>
                                                    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1,1,1,2" Padding="6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Keys}" FontSize="14" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource NavButton}" Command="{Binding NewCommand}" Margin="0,12,0,0" Background="Transparent"
                    BorderBrush="{DynamicResource StrokeStrong}" m:Entrance.Stagger="Self">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Plus}" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                    <TextBlock Text="새 프로필" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
