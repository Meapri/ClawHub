<UserControl x:Class="ClawApp.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:ClawApp.Motion"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <ScrollViewer Margin="42,-6,40,12">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="6">
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" m:Entrance.Stagger="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Keyboard}" Style="{StaticResource Icon}" FontSize="24"
                                           VerticalAlignment="Top" Margin="0,2,18,0" Foreground="{DynamicResource Accent}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" Foreground="{DynamicResource TextDim}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Profile.Name}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding UsedBy}" Style="{StaticResource Caption}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource NavButton}" Command="{Binding NewCommand}" Margin="0,12,0,0" Background="Transparent"
                    m:Entrance.Stagger="Self">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Plus}" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                    <TextBlock Text="새 프로필" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
