<UserControl x:Class="ClawApp.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <ScrollViewer Margin="32,0,32,12">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NavButton}"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}" Foreground="{StaticResource TextDim}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Profile.Name}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding UsedBy}" Style="{StaticResource Caption}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource NavButton}" Command="{Binding NewCommand}" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="새 프로필"/></StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
