<UserControl x:Class="ClawApp.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             xmlns:m="clr-namespace:ClawApp.Motion"
             xmlns:v="clr-namespace:ClawApp.Views"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <!--
        프로필 목록: 내 프로필 / 기본 제공 템플릿. 줄 = [본문: 이름·배지·요약·쓰는 게임·버튼 미리보기 (A 편집)] [이름(Y) · 복제(X) · 삭제].
        삭제는 확인 창을 거친다. 이름 바꾸기는 목록 위 입력줄에서.
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="ProfileRowTemplate">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Tag="main" Style="{StaticResource NavButton}" HorizontalContentAlignment="Stretch" Padding="20,14" Margin="0"
                        local:Nav.InitialFocus="True"
                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <DockPanel>
                        <TextBlock x:Name="KindIcon" DockPanel.Dock="Left" Text="{StaticResource Icon.User}" Style="{StaticResource Icon}" FontSize="24"
                                   VerticalAlignment="Top" Margin="0,2,18,0" Foreground="{DynamicResource Accent}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}"
                                   Foreground="{DynamicResource TextDim}" Margin="16,0,0,0"/>
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                        <TextBlock Text="실행 중인 게임이 사용"/>
                                    </Border>
                                    <Border Style="{StaticResource BadgeOutline}" Margin="6,0,0,0" Visibility="{Binding IsPreset, Converter={StaticResource Vis}}">
                                        <TextBlock Text="기본 제공"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                            <!-- 쓰는 게임: 있으면 본문 색, 없으면 흐리게 -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{StaticResource Icon.Gamepad2}" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextDim}"/>
                                <TextBlock x:Name="GamesLine" Text="{Binding GamesText}" FontSize="15" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                            <!-- 주요 버튼 미리보기: [A] Space  [X] Z ... -->
                            <ItemsControl ItemsSource="{Binding Preview}" Focusable="False" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                            <v:ButtonGlyph Key="{Binding Button}" Width="24" Height="24" Margin="0,0,6,0"/>
                                            <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1,1,1,2" Padding="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Keys}" FontSize="14" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <!-- 줄 동작 (터치·패드 →). 패드는 X/Y로 바로도 된다 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource RowActionButton}" ToolTip="이름 바꾸기 (Y)"
                            Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Icon.Pencil}" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <v:ButtonGlyph Key="Y" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="이름"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RowActionButton}" ToolTip="복제 (X)"
                            Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Icon.CopyPlus}" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <v:ButtonGlyph Key="X" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="복제"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource RowActionButton}" ToolTip="삭제 (두 번 눌러요)"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{StaticResource Icon.Trash2}" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DeleteLabel" Text="삭제" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPreset}" Value="True">
                    <Setter TargetName="KindIcon" Property="Text" Value="{StaticResource Icon.BadgeCheck}"/>
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource TextDim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InUse}" Value="True">
                    <Setter TargetName="GamesLine" Property="Foreground" Value="{DynamicResource Text}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 줄 폭은 최대 1000, 왼쪽 48에 붙인다 (MaxWidth만 주면 가운데로 가 버림) -->
    <Grid Margin="48,0,40,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1000"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
    <DockPanel>
        <!-- 머리: 개수 안내 + 새 프로필 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding NewCommand}" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Plus}" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                    <TextBlock Text="새 프로필" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" FontSize="16" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- 이름 바꾸기 입력줄 (Y·연필 버튼으로 열림, 다 쓰면 Enter·B·다른 곳 누르기 = 저장) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Margin="0,0,0,12"
                Visibility="{Binding RenameRow, Converter={StaticResource NullVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding RenameRow.Name, Mode=OneWay}" Foreground="{DynamicResource Text}" FontWeight="SemiBold"/><Run Text=" 이름 바꾸기 · 다 쓰면 Enter나 B를 눌러요"/>
                </TextBlock>
                <v:InlineEdit x:Name="RenameBox" Text="{Binding RenameText}" FontSize="18"/>
            </StackPanel>
        </Border>

        <ScrollViewer Margin="-6,-6,-6,0">
            <StackPanel Margin="6">
                <TextBlock Text="내 프로필" Style="{StaticResource Section}" Margin="2,0,0,8"/>
                <TextBlock Style="{StaticResource Caption}" FontSize="16" Margin="2,0,0,8"
                           Text="아직 직접 만든 프로필이 없어요. '새 프로필'로 만들거나, 아래 템플릿을 X로 복제해서 시작해 보세요."
                           Visibility="{Binding HasUserRows, Converter={StaticResource NotVis}}"/>
                <ItemsControl x:Name="UserList" ItemsSource="{Binding UserRows}" ItemTemplate="{StaticResource ProfileRowTemplate}"
                              Focusable="False" m:Entrance.Stagger="Items"/>

                <StackPanel Visibility="{Binding HasPresetRows, Converter={StaticResource Vis}}">
                    <TextBlock Text="기본 제공 템플릿" Style="{StaticResource Section}"/>
                    <TextBlock Text="바로 써도 되고, X로 복제해서 게임에 맞게 고쳐 써도 돼요." Style="{StaticResource Caption}" Margin="2,0,0,8"/>
                </StackPanel>
                <ItemsControl x:Name="PresetList" ItemsSource="{Binding PresetRows}" ItemTemplate="{StaticResource ProfileRowTemplate}"
                              Focusable="False" m:Entrance.Stagger="Items"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Grid>
</UserControl>
