<UserControl x:Class="ClawApp.Views.QuickAccessPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
        <ScrollViewer Padding="22,24">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BatteryText}" Style="{StaticResource Caption}" VerticalAlignment="Bottom"/>
                    <TextBlock Text="퀵 설정" Style="{StaticResource H1}" FontSize="26"/>
                </DockPanel>

                <!-- 게임 -->
                <StackPanel Visibility="{Binding TargetTitle, Converter={StaticResource NullVis}}">
                    <TextBlock Text="키 매핑" Style="{StaticResource Section}"/>
                    <Button Style="{StaticResource NavButton}" Command="{Binding CycleProfileCommand}" local:Nav.InitialFocus="True"
                            HorizontalContentAlignment="Stretch">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="A로 변경" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding TargetTitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProfileText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="2,0,0,0"
                               Text="패널을 닫으면 적용되고, 다음에 이 게임을 켜면 자동으로 적용됩니다."/>
                </StackPanel>

                <!-- 성능 -->
                <TextBlock Text="성능" Style="{StaticResource Section}"/>
                <TextBlock Text="{Binding PerfUnavailableText}" Style="{StaticResource Caption}" Foreground="{StaticResource Warn}" Margin="0,0,0,8"
                           Visibility="{Binding PerfAvailable, Converter={StaticResource NotVis}}"/>
                <WrapPanel IsEnabled="{Binding PerfAvailable}">
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="perf" Content="절전" IsChecked="{Binding IsBattery}" local:Nav.InitialFocus="True"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="perf" Content="균형" IsChecked="{Binding IsBalanced}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="perf" Content="성능" IsChecked="{Binding IsPerformance}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="perf" Content="수동" IsChecked="{Binding IsManualMode}"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,4"><Run Text="TDP "/><Run Text="{Binding TdpText, Mode=OneWay}"/></TextBlock>
                <StackPanel Visibility="{Binding IsManual, Converter={StaticResource Vis}}" IsEnabled="{Binding PerfAvailable}">
                    <TextBlock Text="지속 전력 (PL1)" FontSize="14" Margin="2,6,0,0"/>
                    <Slider Minimum="8" Maximum="45" SmallChange="1" Value="{Binding Pl1}"/>
                    <TextBlock Text="최대 전력 (PL2)" FontSize="14" Margin="2,6,0,0"/>
                    <Slider Minimum="8" Maximum="45" SmallChange="1" Value="{Binding Pl2}"/>
                </StackPanel>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding CoolerBoost}" IsEnabled="{Binding PerfAvailable}"
                              HorizontalAlignment="Left" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="쿨러 부스트 (팬 최대)"/></StackPanel>
                </ToggleButton>

                <!-- 화면/소리 -->
                <TextBlock Text="밝기" Style="{StaticResource Section}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Brightness}" Width="36" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding Brightness}"/>
                </DockPanel>
                <TextBlock Text="볼륨" Style="{StaticResource Section}"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Volume}" Width="36" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding Volume}"/>
                </DockPanel>

                <!-- 배터리 -->
                <TextBlock Text="충전 한도 (배터리 수명)" Style="{StaticResource Section}"/>
                <WrapPanel IsEnabled="{Binding ChargeLimitAvailable}">
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="limit" Content="100%" IsChecked="{Binding Limit100}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="limit" Content="80%" IsChecked="{Binding Limit80}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="limit" Content="60%" IsChecked="{Binding Limit60}"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
