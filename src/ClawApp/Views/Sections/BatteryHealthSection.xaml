<!-- 배터리 수명 (읽기 전용). DataContext = PowerSettingsViewModel -->
<UserControl x:Class="ClawApp.Views.Sections.BatteryHealthSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="배터리 수명" Style="{DynamicResource Section}" Margin="2,0,0,8"/>

        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding NoHealth, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding HealthUnavailableText}" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
        </Border>

        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding HasHealth, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Icon.Battery}" FontFamily="{DynamicResource LucideFont}"
                               Style="{DynamicResource Icon}" FontSize="24" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding HealthPercentText}" Style="{DynamicResource H2}"/>
                        <TextBlock Text="{Binding HealthSummary}" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="설계 용량" Style="{DynamicResource Caption}" Margin="0,0,24,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DesignedText}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="1" Text="현재 완충 용량" Style="{DynamicResource Caption}" Margin="0,0,24,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullChargeText}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="2" Text="충방전 횟수" Style="{DynamicResource Caption}" Margin="0,0,24,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CycleText}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="3" Text="제조사" Style="{DynamicResource Caption}" Margin="0,0,24,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ManufacturerText}" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Style="{DynamicResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="완충 용량 ÷ 설계 용량. 새 배터리는 100%를 조금 넘기도 해요. 충전 한도를 80%로 두면 수명에 도움이 돼요."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
