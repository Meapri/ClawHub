<!-- 배터리 전용 기본값 (성능 모드, FPS 제한). DataContext = PowerSettingsViewModel -->
<UserControl x:Class="ClawApp.Views.Sections.BatteryPowerSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClawApp.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel Margin="2,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding PowerSourceText}" Style="{DynamicResource Caption}" VerticalAlignment="Bottom"/>
            <TextBlock Text="배터리로 돌 때" Style="{DynamicResource Section}"/>
        </DockPanel>

        <Border Style="{DynamicResource CardPanel}" IsEnabled="{Binding BatteryPerfAvailable}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Icon.Gauge}" FontFamily="{DynamicResource LucideFont}" Style="{DynamicResource Icon}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="성능 모드" VerticalAlignment="Center"/>
                </StackPanel>
                <WrapPanel>
                    <RadioButton Style="{DynamicResource ChipRadio}" Content="따로 안 씀" IsChecked="{Binding BatPerfNone}"/>
                    <RadioButton Style="{DynamicResource ChipRadio}" Content="절전" IsChecked="{Binding BatPerfBattery}"/>
                    <RadioButton Style="{DynamicResource ChipRadio}" Content="균형" IsChecked="{Binding BatPerfBalanced}"/>
                    <RadioButton Style="{DynamicResource ChipRadio}" Content="성능" IsChecked="{Binding BatPerfPerformance}"/>
                </WrapPanel>
                <TextBlock Text="{Binding BatteryPerfText}" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding GpuAvailable, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Icon.Timer}" FontFamily="{DynamicResource LucideFont}" Style="{DynamicResource Icon}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="FPS 제한" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding BatteryFpsChoices}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <cv:ChoiceChip Style="{DynamicResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding DataContext.PickBatteryFpsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding BatteryFpsText}" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
