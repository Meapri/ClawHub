<UserControl x:Class="ClawApp.Views.Sections.CaptureSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Game Bar 캡처 (DataContext = ShellViewModel). 런처가 떠 있으면 숨긴 뒤 게임을 찍는다.
        "최근 30초 저장"은 Windows 설정 → 게임 → 캡처 → "방금 일어난 일 기록"이 켜져 있어야 한다.
    -->
    <StackPanel>
        <TextBlock Text="캡처" Style="{StaticResource Section}" Margin="2,0,0,8"/>
        <WrapPanel>
            <Button Style="{StaticResource NavButton}" Command="{Binding ScreenshotCommand}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Icon.Camera}" FontFamily="{DynamicResource LucideFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="스크린샷"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource NavButton}" Command="{Binding ToggleRecordingCommand}" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Icon.Video}" FontFamily="{DynamicResource LucideFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="녹화 시작/중지"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource NavButton}" Command="{Binding SaveLast30sCommand}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Icon.Film}" FontFamily="{DynamicResource LucideFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="최근 30초 저장"/>
                </StackPanel>
            </Button>
        </WrapPanel>
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,0"
                   Text="Windows Game Bar로 저장돼요 (동영상\캡처 폴더). 최근 30초 저장은 설정 → 게임 → 캡처의 '방금 일어난 일 기록'을 켜야 해요."/>
    </StackPanel>
</UserControl>
