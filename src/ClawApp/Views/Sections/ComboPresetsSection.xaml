<UserControl x:Class="ClawApp.Views.Sections.ComboPresetsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 키 선택 패널의 조합키 프리셋 (DataContext = MappingEditorViewModel). A = 지정, 다시 A = 해제. -->
    <StackPanel>
        <TextBlock Text="자주 쓰는 조합" Style="{StaticResource Caption}" Margin="2,0,0,6"/>
        <ItemsControl ItemsSource="{Binding ComboPresets}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 패드 A는 ToggleButton의 Command를 실행하지 않으므로(자동화 Toggle) 일반 Button + 선택 표시 -->
                    <Button Style="{StaticResource NavButton}" Margin="0,0,8,8"
                            Command="{Binding DataContext.ApplyComboCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Icon.Check}" FontFamily="{DynamicResource LucideFont}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,8,0"
                                       Visibility="{Binding IsSelected, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding Label}"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,0"
                   Text="Game Bar 단축키입니다. 스크린샷(Win+Alt+PrtSc)은 컨트롤러가 PrtSc 키를 낼 수 없어 Game Bar 위젯의 캡처 버튼을 쓰세요."/>
    </StackPanel>
</UserControl>
