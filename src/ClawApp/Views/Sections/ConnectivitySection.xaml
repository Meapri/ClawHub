<!-- 연결: Wi-Fi · 블루투스 · 비행기 모드, 지금 네트워크, 페어링된 블루투스 기기. DataContext = ConnectivityViewModel (ShellViewModel.Connections) -->
<UserControl x:Class="ClawApp.Views.Sections.ConnectivitySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="네트워크" Style="{DynamicResource Section}" Margin="2,0,0,8"/>
        <Border Style="{DynamicResource CardPanel}">
            <StackPanel>
                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding WifiOn}" IsEnabled="{Binding HasWifi}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Icon.Wifi}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Wi-Fi"/>
                            <TextBlock Text="{Binding NetworkText}" Style="{DynamicResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding AirplaneOn}" IsEnabled="{Binding HasAirplane}" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Icon.Plane}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="비행기 모드"/>
                            <TextBlock Text="Wi-Fi·블루투스를 모두 꺼요 (켠 뒤에 Wi-Fi·블루투스만 다시 켤 수도 있어요)" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ToggleButton>
                <Button Style="{DynamicResource NavButton}" Command="{Binding OpenWifiSettingsCommand}" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Icon.ExternalLink}" Style="{DynamicResource Icon}" FontSize="16" Opacity="0.6"/>
                        <TextBlock Text="다른 네트워크 고르기 · 비밀번호 입력 (Windows 설정)" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Text="블루투스" Style="{DynamicResource Section}" Margin="2,20,0,8"/>
        <Border Style="{DynamicResource CardPanel}">
            <StackPanel>
                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding BluetoothOn}" IsEnabled="{Binding HasBluetooth}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Icon.Bluetooth}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                        <TextBlock Text="블루투스" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <TextBlock Text="페어링된 기기" Style="{DynamicResource Caption}" Margin="2,12,0,4"/>
                <TextBlock Text="페어링된 기기가 없어요" Style="{DynamicResource Caption}" Margin="2,0,0,4"
                           Visibility="{Binding HasDevices, Converter={StaticResource NotVis}}"/>
                <ItemsControl ItemsSource="{Binding Devices}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,5">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Connected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Icon}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{DynamicResource NavButton}" Command="{Binding OpenBluetoothSettingsCommand}" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Icon.ExternalLink}" Style="{DynamicResource Icon}" FontSize="16" Opacity="0.6"/>
                        <TextBlock Text="새 기기 연결 · 연결 끊기 · 제거 (Windows 설정)" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
