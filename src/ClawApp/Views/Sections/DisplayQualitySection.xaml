<UserControl x:Class="ClawApp.Views.Sections.DisplayQualitySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:ClawApp">
    <!--
        설정 → 디스플레이 → "화면 품질" (Intel 드라이버, 서비스 경유).
        DataContext = SettingsViewModel.DisplayQuality (DisplayQualityViewModel).
        스타일·색·아이콘은 모두 DynamicResource — 테마 사전이 바뀌어도 이 파일은 그대로 빌드된다.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <app:NullToVisibility x:Key="NullToVis"/>
        <Style x:Key="RowIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource LucideFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="화면 품질" Style="{DynamicResource Section}"/>

        <!-- 사용할 수 없을 때 -->
        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding UnavailableText, Converter={StaticResource NullToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Icon.TriangleAlert}" Style="{StaticResource RowIcon}" Foreground="{DynamicResource Warn}"/>
                <TextBlock Text="{Binding UnavailableText}" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 레트로(정수) 스케일링 -->
        <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding RetroScaling}"
                      Visibility="{Binding RetroSupported, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Icon.Monitor}" Style="{StaticResource RowIcon}"/>
                <StackPanel>
                    <TextBlock Text="레트로 스케일링"/>
                    <TextBlock Text="낮은 해상도를 정수 배율로 키워 픽셀이 뭉개지지 않게 해요. 바꿀 때 화면이 잠깐 깜빡여요."
                               Style="{DynamicResource Caption}"/>
                </StackPanel>
            </StackPanel>
        </ToggleButton>
        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding RetroModeChoice, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="스케일링 방식" Margin="0,0,0,10"/>
                <WrapPanel>
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="retroMode" Content="정수 배율" IsChecked="{Binding RetroInteger}"/>
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="retroMode" Content="최근접 이웃" IsChecked="{Binding RetroNearest}"/>
                </WrapPanel>
                <TextBlock Text="정수 배율은 화면 가장자리에 검은 테두리가 생길 수 있고, 최근접 이웃은 화면을 꽉 채워요."
                           Style="{DynamicResource Caption}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- 선명도 -->
        <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding Sharpening}"
                      Visibility="{Binding SharpeningSupported, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Icon.Sparkles}" Style="{StaticResource RowIcon}"/>
                <StackPanel>
                    <TextBlock Text="선명도"/>
                    <TextBlock Text="화면 출력 단계에서 경계를 또렷하게 해요 (모든 앱·게임에 적용)" Style="{DynamicResource Caption}"/>
                </StackPanel>
            </StackPanel>
        </ToggleButton>
        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding SharpeningSupported, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SharpeningLevel}" Width="44" TextAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Icon.SlidersHorizontal}" Style="{StaticResource RowIcon}"/>
                        <TextBlock Text="선명도 강도" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <Slider Minimum="{Binding SharpeningMin}" Maximum="{Binding SharpeningMax}" SmallChange="1" LargeChange="1"
                        TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SharpeningLevel}"/>
            </StackPanel>
        </Border>

        <!-- 저지연 -->
        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding LowLatencySupported, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Icon.Zap}" Style="{StaticResource RowIcon}"/>
                    <StackPanel>
                        <TextBlock Text="저지연 모드"/>
                        <TextBlock Text="입력 지연을 줄여요 (DirectX 9·11 게임, 드라이버 전역 설정)" Style="{DynamicResource Caption}"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel>
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="lowLatency" Content="끔" IsChecked="{Binding LowLatencyOff}"/>
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="lowLatency" Content="켬" IsChecked="{Binding LowLatencyOn}"/>
                    <RadioButton Style="{DynamicResource ChipRadio}" GroupName="lowLatency" Content="켬 + 부스트" IsChecked="{Binding LowLatencyBoost}"
                                 Visibility="{Binding BoostSupported, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 가변 주사율 (읽기 전용) -->
        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Icon.Activity}" Style="{StaticResource RowIcon}"/>
                <StackPanel>
                    <TextBlock Text="가변 주사율 (VRR)"/>
                    <TextBlock Text="{Binding VrrText}" Style="{DynamicResource Caption}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
