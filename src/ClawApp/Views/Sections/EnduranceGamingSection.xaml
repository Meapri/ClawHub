<!-- Intel Endurance Gaming (Auto TDP). DataContext = PowerSettingsViewModel (SettingsViewModel.Power / QuickAccessViewModel.Power) -->
<UserControl x:Class="ClawApp.Views.Sections.EnduranceGamingSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Endurance Gaming (자동 TDP)" Style="{DynamicResource Section}" Margin="2,0,0,8"/>
        <Border Style="{DynamicResource CardPanel}" IsEnabled="{Binding EnduranceAvailable}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Icon.Leaf}" FontFamily="{DynamicResource LucideFont}"
                               Style="{DynamicResource Icon}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Intel 드라이버가 프레임과 전력을 알아서 줄여 배터리를 아껴요" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EnduranceNote}" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel>
                    <RadioButton Style="{DynamicResource ChipRadio}" Content="끔" IsChecked="{Binding EgOff}"/>
                    <RadioButton Style="{DynamicResource ChipRadio}" Content="자동 (배터리일 때)" IsChecked="{Binding EgAuto}"/>
                    <RadioButton Style="{DynamicResource ChipRadio}" Content="항상 켬" IsChecked="{Binding EgOn}"/>
                </WrapPanel>
                <StackPanel Visibility="{Binding EgModeVisible, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                    <TextBlock Text="강도" Style="{DynamicResource Caption}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <RadioButton Style="{DynamicResource ChipRadio}" Content="성능 우선" IsChecked="{Binding EgPerformance}"/>
                        <RadioButton Style="{DynamicResource ChipRadio}" Content="균형" IsChecked="{Binding EgBalanced}"/>
                        <RadioButton Style="{DynamicResource ChipRadio}" Content="배터리 최대" IsChecked="{Binding EgMaxBattery}"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
