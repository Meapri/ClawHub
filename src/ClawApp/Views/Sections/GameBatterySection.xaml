<!-- 게임별 배터리 전용 성능 모드·FPS 제한. DataContext = GameViewModel -->
<UserControl x:Class="ClawApp.Views.Sections.GameBatterySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="2,16,0,8">
            <TextBlock Text="{DynamicResource Icon.Battery}" FontFamily="{DynamicResource LucideFont}" Style="{DynamicResource Icon}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="배터리로 돌 때" Style="{DynamicResource Section}" VerticalAlignment="Center"/>
        </StackPanel>

        <Button Style="{DynamicResource NavButton}" Command="{Binding CyclePerformanceOnBatteryCommand}" HorizontalContentAlignment="Stretch">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="A로 변경" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="배터리일 때 성능 모드" Style="{DynamicResource Caption}"/>
                    <TextBlock Text="{Binding PerformanceOnBatteryText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Button>

        <Button Style="{DynamicResource NavButton}" Command="{Binding CycleFpsOnBatteryCommand}" HorizontalContentAlignment="Stretch"
                Visibility="{Binding GpuAvailable, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="A로 변경" Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="배터리일 때 FPS 제한" Style="{DynamicResource Caption}"/>
                    <TextBlock Text="{Binding FpsOnBatteryText}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Button>

        <TextBlock Style="{DynamicResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                   Text="'따로 안 씀'이면 배터리여도 위의 게임 중 값을 씁니다. 전원을 꽂거나 뽑으면 게임 중에도 바로 바뀝니다."/>
    </StackPanel>
</UserControl>
