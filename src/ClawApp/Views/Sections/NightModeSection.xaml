<!-- 야간 모드: 지금 켜기, 강도, 예약. DataContext = NightModeViewModel (ShellViewModel.Night) -->
<UserControl x:Class="ClawApp.Views.Sections.NightModeSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ClawApp.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <ItemsPanelTemplate x:Key="ChipWrap"><WrapPanel/></ItemsPanelTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="야간 모드" Style="{DynamicResource Section}" Margin="2,0,0,8"/>
        <Border Style="{DynamicResource CardPanel}">
            <StackPanel>
                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding On}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Icon.Moon}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="지금 켜기"/>
                            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </ToggleButton>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="강도" Width="96" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Strength}" Width="40" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding Strength}"/>
                </DockPanel>
                <TextBlock Text="화면의 파란빛을 줄여 따뜻한 색으로 보여요. 게임 화면에도 적용돼요. 아주 강하게 하면 Windows 한도까지만 적용돼요."
                           Style="{DynamicResource Caption}" TextWrapping="Wrap" Margin="2,4,0,0"/>
                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding Scheduled}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="예약"/>
                        <TextBlock Text="정한 시간에 자동으로 켜고 꺼요 (ClawHub가 켜져 있을 때)" Style="{DynamicResource Caption}"/>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Visibility="{Binding Scheduled, Converter={StaticResource BoolVis}}" Margin="0,8,0,0">
                    <TextBlock Text="켜는 시간" Style="{DynamicResource Caption}" Margin="2,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding StartChoices}" ItemsPanel="{StaticResource ChipWrap}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <v:ChoiceChip Style="{DynamicResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding DataContext.PickStartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="끄는 시간" Style="{DynamicResource Caption}" Margin="2,8,0,4"/>
                    <ItemsControl ItemsSource="{Binding EndChoices}" ItemsPanel="{StaticResource ChipWrap}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <v:ChoiceChip Style="{DynamicResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding DataContext.PickEndCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
