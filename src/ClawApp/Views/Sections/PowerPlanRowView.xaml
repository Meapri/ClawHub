<!-- Windows 전원 설정 한 줄: 오른쪽에 값 버튼 두 개(충전 중 / 배터리), 누른 칸의 칩만 아래로 펼친다.
     지금 전원 상태 칸에는 "지금" 표시. 칩을 고르거나 B를 누르면 접히고 포커스는 값 버튼으로 돌아간다.
     DataContext = PowerPlanRow, IconText = 아이콘 (예: {DynamicResource Icon.Monitor}) -->
<UserControl x:Class="ClawApp.Views.Sections.PowerPlanRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClawApp.Views"
             xmlns:ipc="clr-namespace:ClawCore.Ipc;assembly=ClawCore"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisLocal"/>
        <DataTemplate x:Key="ChipTemplate">
            <cv:ChoiceChip Style="{DynamicResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"/>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate"><WrapPanel/></ItemsPanelTemplate>

        <!-- 값 버튼: 위 작은 글씨(칸 이름 · 지금), 아래 값 + 펼침 표시. 펼친 칸은 강조색 밑줄 -->
        <Style x:Key="ValuePick" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Width" Value="184"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{DynamicResource CardPanel}" IsEnabled="{Binding IsEnabled}"
            Visibility="{Binding IsAvailable, Converter={StaticResource BoolVisLocal}}">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AcButton" Style="{StaticResource ValuePick}"
                            Command="{Binding ExpandCommand}" CommandParameter="{x:Static ipc:PowerSourceKind.Ac}"
                            Visibility="{Binding AcApplies, Converter={StaticResource BoolVisLocal}}"
                            AutomationProperties.Name="충전 중 값 바꾸기">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Icon.PlugZap}" FontFamily="{DynamicResource LucideFont}" FontSize="13"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="충전 중" Style="{DynamicResource Caption}"/>
                                <Border Style="{DynamicResource Badge}" Padding="5,0" Margin="6,0,0,0"
                                        Visibility="{Binding AcIsCurrent, Converter={StaticResource BoolVisLocal}}">
                                    <TextBlock Text="지금" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <DockPanel Grid.Row="1" Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Icon.ChevronRight}" FontFamily="{DynamicResource LucideFont}"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AcExpanded}" Value="True">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding AcText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <Border Grid.RowSpan="2" Height="3" VerticalAlignment="Bottom" Margin="-14,0,-14,-8" Background="{DynamicResource Accent}"
                                    Visibility="{Binding AcExpanded, Converter={StaticResource BoolVisLocal}}"/>
                        </Grid>
                    </Button>

                    <Button x:Name="DcButton" Style="{StaticResource ValuePick}"
                            Command="{Binding ExpandCommand}" CommandParameter="{x:Static ipc:PowerSourceKind.Battery}"
                            AutomationProperties.Name="배터리 값 바꾸기">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Icon.Battery}" FontFamily="{DynamicResource LucideFont}" FontSize="13"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="배터리" Style="{DynamicResource Caption}"/>
                                <Border Style="{DynamicResource Badge}" Padding="5,0" Margin="6,0,0,0"
                                        Visibility="{Binding DcIsCurrent, Converter={StaticResource BoolVisLocal}}">
                                    <TextBlock Text="지금" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <DockPanel Grid.Row="1" Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Icon.ChevronRight}" FontFamily="{DynamicResource LucideFont}"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DcExpanded}" Value="True">
                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DcText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <Border Grid.RowSpan="2" Height="3" VerticalAlignment="Bottom" Margin="-14,0,-14,-8" Background="{DynamicResource Accent}"
                                    Visibility="{Binding DcExpanded, Converter={StaticResource BoolVisLocal}}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <TextBlock DockPanel.Dock="Left" Text="{Binding IconText, ElementName=Root}" FontFamily="{DynamicResource LucideFont}"
                           Style="{DynamicResource Icon}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Title}"/>
                    <TextBlock Text="{Binding Description}" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ExtraNote}" Style="{DynamicResource Caption}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                               Visibility="{Binding HasExtraNote, Converter={StaticResource BoolVisLocal}}"/>
                    <TextBlock Text="배터리로 돌 때만 쓰는 설정이에요" Style="{DynamicResource Caption}"
                               Visibility="{Binding AcNotApplicable, Converter={StaticResource BoolVisLocal}}"/>
                </StackPanel>
            </DockPanel>

            <!-- 펼친 칸의 칩 -->
            <ItemsControl x:Name="Chips" ItemsSource="{Binding ExpandedChoices}" Focusable="False" ItemTemplate="{StaticResource ChipTemplate}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}" Margin="0,14,0,-8"
                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisLocal}}"/>
        </StackPanel>
    </Border>
</UserControl>
