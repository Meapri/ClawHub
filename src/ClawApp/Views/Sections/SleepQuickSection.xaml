<!-- 빠른 설정용 화면 끄기 / 절전 (지금 전원 상태 칸). DataContext = PowerPlanViewModel (QuickAccessViewModel.PowerPlan) -->
<UserControl x:Class="ClawApp.Views.Sections.SleepQuickSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:ClawApp.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <DataTemplate x:Key="ChipTemplate">
            <cv:ChoiceChip Style="{DynamicResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"/>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate"><WrapPanel/></ItemsPanelTemplate>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="2,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding QuickSourceText}" Style="{DynamicResource Caption}" VerticalAlignment="Bottom"/>
            <TextBlock Text="화면·절전" Style="{DynamicResource Section}"/>
        </DockPanel>

        <Border Style="{DynamicResource CardPanel}" IsEnabled="{Binding Available}">
            <StackPanel>
                <StackPanel DataContext="{Binding DisplayOff}" IsEnabled="{Binding IsEnabled}"
                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolVis}}" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Icon.Monitor}" FontFamily="{DynamicResource LucideFont}" Style="{DynamicResource Icon}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding CurrentChoices}" Focusable="False" ItemTemplate="{StaticResource ChipTemplate}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                </StackPanel>

                <StackPanel DataContext="{Binding Sleep}" IsEnabled="{Binding IsEnabled}"
                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource Icon.Moon}" FontFamily="{DynamicResource LucideFont}" Style="{DynamicResource Icon}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding CurrentChoices}" Focusable="False" ItemTemplate="{StaticResource ChipTemplate}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                </StackPanel>

                <TextBlock Text="{Binding Note}" Style="{DynamicResource Caption}" TextWrapping="Wrap"
                           Visibility="{Binding NotAvailable, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
