<!-- 사운드: 출력·입력 장치, 소리 끄기, 마이크 레벨, 앱별 볼륨, 통화 중 다른 소리. DataContext = SoundViewModel (ShellViewModel.Sound) -->
<UserControl x:Class="ClawApp.Views.Sections.SoundSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ClawApp.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <ItemsPanelTemplate x:Key="ChipWrap"><WrapPanel/></ItemsPanelTemplate>
        <DataTemplate x:Key="OutputChip">
            <v:ChoiceChip Style="{DynamicResource Chip}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding DataContext.PickOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Key="InputChip">
            <v:ChoiceChip Style="{DynamicResource Chip}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding DataContext.PickInputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="사운드" Style="{DynamicResource Section}" Margin="2,0,0,8"/>

        <!-- 출력 -->
        <Border Style="{DynamicResource CardPanel}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Icon.Volume2}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                    <TextBlock Text="출력 장치" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Outputs}" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource OutputChip}" Focusable="False"/>
                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding SpeakerMuted}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="소리 끄기"/>
                        <TextBlock Text="지금 출력 장치를 음소거해요 (볼륨 값은 그대로)" Style="{DynamicResource Caption}"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- 입력 (마이크) -->
        <Border Style="{DynamicResource CardPanel}" Margin="0,8,0,0" Visibility="{Binding HasMic, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Icon.Mic}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                    <TextBlock Text="입력 장치 (마이크)" VerticalAlignment="Center"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Inputs}" ItemsPanel="{StaticResource ChipWrap}" ItemTemplate="{StaticResource InputChip}" Focusable="False"/>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="마이크 크기" Width="96" VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MicLevel}" Width="40" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding MicLevel}"/>
                </DockPanel>
                <ToggleButton Style="{DynamicResource Switch}" IsChecked="{Binding MicOn}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="마이크 켜짐"/>
                        <TextBlock Text="끄면 연결된 마이크가 모두 꺼져요 (버튼 매핑의 '마이크 켜기/끄기'와 같아요)" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- 앱별 볼륨 (볼륨 믹서) -->
        <Border Style="{DynamicResource CardPanel}" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Icon.SlidersHorizontal}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="앱별 볼륨"/>
                        <TextBlock Text="지금 출력 장치에서 소리를 낼 수 있는 앱" Style="{DynamicResource Caption}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="지금 소리를 내는 앱이 없어요" Style="{DynamicResource Caption}" Margin="2,0,0,0"
                           Visibility="{Binding HasApps, Converter={StaticResource NotVis}}"/>
                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,0,2">
                                <TextBlock Text="{Binding Name}" Width="150" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <v:ChoiceChip DockPanel.Dock="Right" Style="{DynamicResource Chip}" Margin="10,0,0,0" Padding="10,6"
                                              IsChecked="{Binding Muted, Mode=OneWay}" Command="{Binding ToggleMutedCommand}" Content="음소거"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Volume}" Width="36" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding Volume}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 통화 중 다른 소리 -->
        <Border Style="{DynamicResource CardPanel}" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Icon.Volume1}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="통화할 때 다른 소리"/>
                        <TextBlock Text="Discord 같은 통신 앱이 통화를 시작하면 게임·음악 소리를 어떻게 할지" Style="{DynamicResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding DuckingChoices}" ItemsPanel="{StaticResource ChipWrap}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <v:ChoiceChip Style="{DynamicResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding DataContext.PickDuckingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
