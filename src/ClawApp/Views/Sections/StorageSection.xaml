<!-- 저장소·시스템: 드라이브 사용량, 큰 게임, 기기 정보. DataContext = SystemInfoViewModel (ShellViewModel.SystemInfo) -->
<UserControl x:Class="ClawApp.Views.Sections.StorageSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="저장 공간" Style="{DynamicResource Section}" Margin="2,0,0,8"/>
        <Border Style="{DynamicResource CardPanel}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Drives}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Icon.HardDrive}" Style="{DynamicResource Icon}" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,8,0,0" BorderThickness="0"
                                             Foreground="{DynamicResource Accent}" Background="{DynamicResource Divider}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{DynamicResource NavButton}" Command="{Binding OpenStorageSenseCommand}" HorizontalContentAlignment="Stretch">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Icon.ExternalLink}" Style="{DynamicResource Icon}" FontSize="16" Opacity="0.6"/>
                        <TextBlock Text="임시 파일 정리 · 저장 공간 센스 (Windows 설정)" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Text="게임이 차지하는 공간" Style="{DynamicResource Section}" Margin="2,20,0,2"/>
        <TextBlock Text="{Binding GamesNote}" Style="{DynamicResource Caption}" Margin="2,0,0,8"/>
        <Border Style="{DynamicResource CardPanel}" Visibility="{Binding HasGameSizes, Converter={StaticResource BoolVis}}">
            <ItemsControl ItemsSource="{Binding GameSizes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,5">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="시스템 정보" Style="{DynamicResource Section}" Margin="2,20,0,8"/>
        <Border Style="{DynamicResource CardPanel}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextDim}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{DynamicResource NavButton}" Command="{Binding OpenWindowsUpdateCommand}" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Icon.ExternalLink}" Style="{DynamicResource Icon}" FontSize="16" Opacity="0.6"/>
                        <TextBlock Text="Windows 업데이트 확인 (Windows 설정)" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
