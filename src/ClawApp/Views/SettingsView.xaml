<UserControl x:Class="ClawApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             xmlns:m="clr-namespace:ClawApp.Motion"
             xmlns:v="clr-namespace:ClawApp.Views"
             xmlns:s="clr-namespace:ClawApp.Views.Sections"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <!-- 메트로 설정: 왼쪽 분류(글자 위주, 선택 시 강조색 막대) + 오른쪽 내용. 분류가 바뀌면 내용이 계단식으로 다시 들어온다 -->
    <UserControl.Resources>
        <!-- 슬라이더 카드: 제목 · 값 / 슬라이더 -->
        <Style x:Key="SliderTitle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Width" Value="44"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="44,0,40,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── 분류 ─────────────────────────────────────── -->
        <ScrollViewer>
            <ItemsControl x:Name="CategoryList" ItemsSource="{Binding Categories}" Focusable="False" Margin="4,4,4,0" m:Entrance.Stagger="Items" m:Entrance.Offset="-32">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Cat" Style="{StaticResource NavItem}" Tag="{Binding IsSelected}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" GotKeyboardFocus="Category_GotFocus">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Key, Converter={x:Static v:CategoryIconConverter.Instance}}" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding Label}"/>
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Cat" Property="local:Nav.InitialFocus" Value="True"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ScrollViewer x:Name="ContentHost" Grid.Column="1" Margin="28,0,0,0">
            <!-- 분류마다 카드 폭이 내용에 따라 달라지지 않게 한 열(최대 760)로 고정 -->
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="772"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="6,4,6,16">

                <!-- ── 일반 ──────────────────────────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=general}" m:Entrance.Stagger="Items">
                    <TextBlock Text="시작 화면" Style="{StaticResource Section}" Margin="2,0,0,8"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="startup" Content="자동" IsChecked="{Binding StartupAuto}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="startup" Content="ClawHub 전체 화면" IsChecked="{Binding StartupShell}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="startup" Content="Xbox 모드 동반" IsChecked="{Binding StartupCompanion}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding CompanionText}" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="자동: 켤 때 Xbox 앱이 이미 떠 있으면(Xbox 모드) 숨은 채로 버튼·자동 매핑만 담당해요."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="동작" Style="{StaticResource Section}"/>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}">
                        <StackPanel>
                            <TextBlock Text="Windows 시작 시 ClawHub 실행"/>
                            <TextBlock Text="로그인하면 자동으로 켜져요" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding AutoControllerMode}">
                        <StackPanel>
                            <TextBlock Text="컨트롤러 모드 자동 전환"/>
                            <TextBlock Text="런처·게임에서는 게임패드, 데스크톱에서는 스틱이 마우스" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MsiCenterEnabled}" IsEnabled="{Binding MsiCenterKnown}">
                        <StackPanel>
                            <TextBlock Text="MSI Center M 사용"/>
                            <TextBlock Text="끄면 본체 버튼·성능·조명을 ClawHub만 제어해요. 삭제하지 않으므로 언제든 다시 켤 수 있어요." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </ToggleButton>
                    <s:DesktopModeSection Margin="0,20,0,0"/>
                </StackPanel>

                <!-- ── 컨트롤러 ──────────────────────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=controller}" m:Entrance.Stagger="Items"
                            IsEnabled="{Binding ControllerAvailable}">
                    <TextBlock Text="감도" Style="{StaticResource Section}" Margin="2,0,0,8"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Vibration}" Style="{StaticResource Value}"/><TextBlock Text="진동 세기" Style="{StaticResource SliderTitle}"/></DockPanel>
                            <Slider Minimum="0" Maximum="100" SmallChange="10" TickFrequency="10" Value="{Binding Vibration}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding LeftDeadzone}" Style="{StaticResource Value}"/><TextBlock Text="왼쪽 스틱 데드존" Style="{StaticResource SliderTitle}"/></DockPanel>
                            <Slider Minimum="0" Maximum="30" SmallChange="1" Value="{Binding LeftDeadzone}"/>
                            <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding RightDeadzone}" Style="{StaticResource Value}"/><TextBlock Text="오른쪽 스틱 데드존" Style="{StaticResource SliderTitle}"/></DockPanel>
                            <Slider Minimum="0" Maximum="30" SmallChange="1" Value="{Binding RightDeadzone}"/>
                            <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding TriggerDeadzone}" Style="{StaticResource Value}"/><TextBlock Text="트리거 데드존 (LT·RT)" Style="{StaticResource SliderTitle}"/></DockPanel>
                            <Slider Minimum="0" Maximum="40" SmallChange="1" Value="{Binding TriggerDeadzone}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="버튼" Style="{StaticResource Section}"/>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SwapAbxy}">
                        <StackPanel>
                            <TextBlock Text="A↔B, X↔Y 위치 바꾸기"/>
                            <TextBlock Text="닌텐도 배치" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding DiagonalLock}">
                        <StackPanel>
                            <TextBlock Text="방향 버튼 대각선 입력 막기"/>
                            <TextBlock Text="격투·퍼즐 게임에서 오입력 방지" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenProfilesCommand}" HorizontalContentAlignment="Stretch">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.Keyboard}" Style="{StaticResource Icon}" Margin="0,0,16,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="12"/>
                            <StackPanel>
                                <TextBlock Text="키 매핑 프로필"/>
                                <TextBlock Text="버튼을 키보드·마우스 입력으로 바꾸는 게임별 설정" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ResetControllerCommand}" Margin="0,12,0,4">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.RotateCcw}" Style="{StaticResource Icon}" Margin="0,0,14,0"/><TextBlock Text="컨트롤러 설정 원래대로"/></StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,0"
                               Text="설정은 컨트롤러 메모리에만 쓰고 ClawHub가 켜질 때마다 다시 적용해요. 펌웨어(플래시)는 건드리지 않아요."/>
                </StackPanel>

                <!-- ── 조명 ──────────────────────────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=light}" m:Entrance.Stagger="Items"
                            IsEnabled="{Binding ControllerAvailable}">
                    <TextBlock Text="스틱 조명" Style="{StaticResource Section}" Margin="2,0,0,8"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="light" Content="기본 효과" IsChecked="{Binding LightDefault}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="light" Content="단색" IsChecked="{Binding LightStatic}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="light" Content="숨쉬기" IsChecked="{Binding LightBreath}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="light" Content="무지개" IsChecked="{Binding LightRainbow}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="light" Content="웨이브" IsChecked="{Binding LightWave}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="light" Content="끄기" IsChecked="{Binding LightOff}"/>
                            </WrapPanel>
                            <StackPanel Visibility="{Binding HasSpeed, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                                <TextBlock Text="속도" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="lspeed" Content="느리게" IsChecked="{Binding SpeedSlow}"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="lspeed" Content="보통" IsChecked="{Binding SpeedNormal}"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="lspeed" Content="빠르게" IsChecked="{Binding SpeedFast}"/>
                                </WrapPanel>
                            </StackPanel>
                            <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding LightBrightness}" Style="{StaticResource Value}"/><TextBlock Text="밝기" Style="{StaticResource SliderTitle}"/></DockPanel>
                            <Slider Minimum="0" Maximum="100" SmallChange="10" TickFrequency="10" Value="{Binding LightBrightness}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="색 (단색·숨쉬기)" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding LightColors}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="14" Height="14" Fill="{Binding Swatch}" Margin="0,0,8,0" Stroke="#40000000"/>
                                                <TextBlock Text="{Binding Label}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding AbxyBrightness}" Style="{StaticResource Value}"/><TextBlock Text="ABXY 버튼 밝기" Style="{StaticResource SliderTitle}"/></DockPanel>
                            <Slider Minimum="0" Maximum="100" SmallChange="10" TickFrequency="10" Value="{Binding AbxyBrightness}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── 성능 (빠른 설정과 공유) ───────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=performance}" m:Entrance.Stagger="Items">
                <StackPanel DataContext="{Binding Quick}">
                    <TextBlock Text="기본 성능 모드" Style="{StaticResource Section}" Margin="2,0,0,8"/>
                    <TextBlock Text="{Binding PerfUnavailableText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Warn}" Margin="0,0,0,8"
                               Visibility="{Binding PerfAvailable, Converter={StaticResource NotVis}}"/>
                    <Border Style="{StaticResource CardPanel}" IsEnabled="{Binding PerfAvailable}">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="sperf" Content="절전" IsChecked="{Binding IsBattery}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="sperf" Content="균형" IsChecked="{Binding IsBalanced}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="sperf" Content="성능" IsChecked="{Binding IsPerformance}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="sperf" Content="수동" IsChecked="{Binding IsManualMode}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}"><Run Text="TDP "/><Run Text="{Binding TdpText, Mode=OneWay}"/></TextBlock>
                            <StackPanel Visibility="{Binding IsManual, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Pl1, StringFormat={}{0}W}" Style="{StaticResource Value}"/><TextBlock Text="지속 전력 (PL1)" Style="{StaticResource SliderTitle}"/></DockPanel>
                                <Slider Minimum="8" Maximum="45" SmallChange="1" Value="{Binding Pl1}"/>
                                <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Pl2, StringFormat={}{0}W}" Style="{StaticResource Value}"/><TextBlock Text="최대 전력 (PL2)" Style="{StaticResource SliderTitle}"/></DockPanel>
                                <Slider Minimum="8" Maximum="45" SmallChange="1" Value="{Binding Pl2}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CoolerBoost}" IsEnabled="{Binding PerfAvailable}">
                        <StackPanel>
                            <TextBlock Text="쿨러 부스트"/>
                            <TextBlock Text="팬을 최대로 돌려요 (소음 증가)" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0"
                               Text="게임마다 다른 성능 모드를 쓰려면 라이브러리 → 게임 → 성능 모드에서 고르세요. 게임이 끝나면 여기 기본값으로 돌아와요."/>
                </StackPanel>
                <s:EnduranceGamingSection DataContext="{Binding Power}" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- ── 디스플레이·사운드 ────────────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=display}" m:Entrance.Stagger="Items">
                    <TextBlock Text="밝기 및 소리" Style="{StaticResource Section}" Margin="2,0,0,8"/>
                    <Border Style="{StaticResource CardPanel}" DataContext="{Binding Quick}">
                        <StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Brightness}" Style="{StaticResource Value}"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Sun}" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="밝기" Style="{StaticResource SliderTitle}"/></StackPanel></DockPanel>
                            <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding Brightness}"/>
                            <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Volume}" Style="{StaticResource Value}"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Volume2}" Style="{StaticResource Icon}" Margin="0,0,12,0"/><TextBlock Text="볼륨" Style="{StaticResource SliderTitle}"/></StackPanel></DockPanel>
                            <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding Volume}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="디스플레이" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="주사율"/>
                            <TextBlock Text="낮추면 배터리가 오래 가요" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding RefreshRates}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.ApplyDisplayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="해상도" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Resolutions}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                      Command="{Binding DataContext.ApplyDisplayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <s:DisplayQualitySection DataContext="{Binding DisplayQuality}" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- ── 배터리 ────────────────────────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=battery}" m:Entrance.Stagger="Items">
                <StackPanel DataContext="{Binding Quick}">
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Battery}" Style="{StaticResource Icon}" FontSize="24" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource H2}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="충전 한도" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource CardPanel}" IsEnabled="{Binding ChargeLimitAvailable}">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="slimit" Content="100% (이동용)" IsChecked="{Binding Limit100}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="slimit" Content="80% (균형)" IsChecked="{Binding Limit80}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="slimit" Content="60% (배터리 수명)" IsChecked="{Binding Limit60}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="충전기에 오래 꽂아 두고 쓴다면 80% 이하가 배터리 수명에 좋아요."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <s:BatteryPowerSection DataContext="{Binding Power}" Margin="0,20,0,0"/>
                <s:PowerPlanSection DataContext="{Binding PowerPlan}" Margin="0,20,0,0"/>
                <s:BatteryHealthSection DataContext="{Binding Power}" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- ── Windows 설정 ─────────────────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=windows}" m:Entrance.Stagger="Items">
                    <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,12"
                               Text="Windows 설정 화면을 열어요. 스틱이 마우스로 바뀌고, 왼쪽 MSI 버튼을 누르면 ClawHub로 돌아와요."/>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenWindowsCommand}" CommandParameter="network-wifi">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Wifi}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="Wi-Fi"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenWindowsCommand}" CommandParameter="bluetooth">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Bluetooth}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="Bluetooth 및 장치"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenWindowsCommand}" CommandParameter="sound">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Volume2}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="사운드 출력 장치"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenWindowsCommand}" CommandParameter="display">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Monitor}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="디스플레이 (배율·HDR)"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenWindowsCommand}" CommandParameter="storagesense">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.HardDrive}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="저장 공간"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding OpenWindowsCommand}" CommandParameter="windowsupdate">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Download}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="Windows 업데이트"/></StackPanel>
                    </Button>
                </StackPanel>

                <!-- ── 라이브러리 ────────────────────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=library}" m:Entrance.Stagger="Items">
                    <Button Style="{StaticResource NavButton}" Command="{Binding AddGameCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Plus}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="게임 직접 추가 (exe·바로가기)"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding RescanCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.RefreshCw}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="설치된 게임 다시 찾기"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding UnhideAllCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Eye}" Style="{StaticResource Icon}" Margin="0,0,16,0"/><TextBlock Text="숨긴 게임 다시 표시"/></StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0"
                               Text="자동 감지: Steam · Epic · GOG · 넥슨·엔씨·스마일게이트·블리자드·라이엇 등 설치된 게임. 라이브러리에 없는 게임도 실행 중에 빠른 설정에서 매핑 프로필을 지정하면 자동으로 등록돼요."/>
                </StackPanel>

                <!-- ── 정보 ──────────────────────────────── -->
                <StackPanel Visibility="{Binding Selected.Key, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=about}" m:Entrance.Stagger="Items">
                    <Border Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="ClawHub" Foreground="{DynamicResource TextDim}" Margin="0,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Text="서비스" Foreground="{DynamicResource TextDim}" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServiceText}" Margin="0,5" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="컨트롤러" Foreground="{DynamicResource TextDim}" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ControllerText}" Margin="0,5" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="3" Text="EC" Foreground="{DynamicResource TextDim}" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EcText}" Margin="0,5" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="4" Text="BIOS" Foreground="{DynamicResource TextDim}" Margin="0,5"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BiosText}" Margin="0,5"/>
                            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding Warnings}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding Warnings, Converter={StaticResource NullVis}}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
