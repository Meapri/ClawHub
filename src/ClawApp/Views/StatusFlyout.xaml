<UserControl x:Class="ClawApp.Views.StatusFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClawApp"
             KeyboardNavigation.DirectionalNavigation="Contained">
    <!--
        상단 상태 표시줄 항목을 누르면 열리는 패널. DataContext = ShellViewModel, 값·동작은 빠른 설정(QuickAccess)과 같다.
        StatusPanel 키마다 한 칸만 보인다.
    -->
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource H2}">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- 값 줄: 글자는 창 기본(본문 16) -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="20">
        <Grid>
            <!-- 서비스 -->
            <StackPanel Visibility="{Binding StatusPanel, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=service}">
                <TextBlock Text="ClawHub 서비스" Style="{StaticResource Head}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,4"
                           Text="서비스가 꺼져 있어 성능·충전 한도·컨트롤러 설정·매핑을 바꿀 수 없어요. 설치 프로그램으로 다시 설치하거나 PC를 다시 시작해 보세요."/>
                <Button Style="{StaticResource Link}" Command="{Binding OpenSettingsAtCommand}" CommandParameter="about" local:Nav.InitialFocus="True">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="정보 · 상태 보기"/></DockPanel>
                </Button>
            </StackPanel>

            <!-- 성능 -->
            <StackPanel DataContext="{Binding QuickAccess}"
                        Visibility="{Binding DataContext.StatusPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=perf}">
                <TextBlock Text="성능" Style="{StaticResource Head}"/>
                <WrapPanel IsEnabled="{Binding PerfAvailable}">
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="fperf" Content="절전" IsChecked="{Binding IsBattery}" local:Nav.InitialFocus="True"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="fperf" Content="균형" IsChecked="{Binding IsBalanced}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="fperf" Content="성능" IsChecked="{Binding IsPerformance}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="fperf" Content="수동" IsChecked="{Binding IsManualMode}"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,8"><Run Text="TDP "/><Run Text="{Binding TdpText, Mode=OneWay}"/></TextBlock>
                <TextBlock Text="{Binding PerfNote}" Style="{StaticResource Caption}" Foreground="{DynamicResource Accent}" Margin="2,0,0,8"
                           Visibility="{Binding PerfNote, Converter={StaticResource NullVis}}"/>
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CoolerBoost}" IsEnabled="{Binding PerfAvailable}">
                    <TextBlock Text="쿨러 부스트"/>
                </ToggleButton>
                <Button Style="{StaticResource Link}" Command="{Binding DataContext.OpenSettingsAtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="performance">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="성능 설정 더 보기"/></DockPanel>
                </Button>
            </StackPanel>

            <!-- 시스템 상태 -->
            <StackPanel DataContext="{Binding QuickAccess}"
                        Visibility="{Binding DataContext.StatusPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=system}">
                <TextBlock Text="시스템 상태" Style="{StaticResource Head}"/>
                <DockPanel Style="{StaticResource Row}"><TextBlock Text="{Binding CpuTempText}" Style="{StaticResource RowValue}"/><TextBlock Text="CPU 온도" Style="{StaticResource RowLabel}"/></DockPanel>
                <DockPanel Style="{StaticResource Row}"><TextBlock Text="{Binding GpuTempText}" Style="{StaticResource RowValue}"/><TextBlock Text="CPU 전력" Style="{StaticResource RowLabel}"/></DockPanel>
                <DockPanel Style="{StaticResource Row}"><TextBlock Text="{Binding PowerText}" Style="{StaticResource RowValue}"/><TextBlock Text="배터리 소모" Style="{StaticResource RowLabel}"/></DockPanel>
                <DockPanel Style="{StaticResource Row}"><TextBlock Text="{Binding TdpText}" Style="{StaticResource RowValue}"/><TextBlock Text="전력 한도 (TDP)" Style="{StaticResource RowLabel}"/></DockPanel>
                <TextBlock Text="2초마다 새로 읽어요" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding CoolerBoost}" IsEnabled="{Binding PerfAvailable}" Margin="0,10,0,0"
                              local:Nav.InitialFocus="True">
                    <TextBlock Text="쿨러 부스트 (팬 최대)"/>
                </ToggleButton>
            </StackPanel>

            <!-- 컨트롤러 -->
            <StackPanel Visibility="{Binding StatusPanel, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=controller}">
                <TextBlock Text="컨트롤러" Style="{StaticResource Head}"/>
                <DockPanel Style="{StaticResource Row}"><TextBlock Text="{Binding ControllerStatusText}" Style="{StaticResource RowValue}"/><TextBlock Text="상태" Style="{StaticResource RowLabel}"/></DockPanel>
                <DockPanel Style="{StaticResource Row}" DataContext="{Binding QuickAccess}">
                    <TextBlock Text="{Binding ProfileText}" Style="{StaticResource RowValue}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="지금 매핑" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <Button Style="{StaticResource Link}" Command="{Binding OpenProfilesCommand}" local:Nav.InitialFocus="True">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Keyboard}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="키 매핑 프로필"/></StackPanel></DockPanel>
                </Button>
                <Button Style="{StaticResource Link}" Command="{Binding OpenSettingsAtCommand}" CommandParameter="controller">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Gamepad2}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="진동·데드존·버튼 설정"/></StackPanel></DockPanel>
                </Button>
                <Button Style="{StaticResource Link}" Command="{Binding OpenSettingsAtCommand}" CommandParameter="light">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Lightbulb}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="스틱 조명"/></StackPanel></DockPanel>
                </Button>
            </StackPanel>

            <!-- 네트워크 -->
            <StackPanel Visibility="{Binding StatusPanel, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=network}">
                <TextBlock Text="네트워크" Style="{StaticResource Head}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{Binding NetworkIcon}" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding NetworkText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource Link}" Command="{Binding OpenWindowsPageCommand}" CommandParameter="network-wifi" local:Nav.InitialFocus="True">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Wifi}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="Wi-Fi 고르기"/></StackPanel></DockPanel>
                </Button>
                <Button Style="{StaticResource Link}" Command="{Binding OpenWindowsPageCommand}" CommandParameter="bluetooth">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{StaticResource Icon.Bluetooth}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="Bluetooth 및 장치"/></StackPanel></DockPanel>
                </Button>
                <TextBlock Text="Windows 설정이 열리고 스틱이 마우스가 돼요. 왼쪽 MSI 버튼으로 돌아와요." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 밝기·소리 -->
            <StackPanel DataContext="{Binding QuickAccess}"
                        Visibility="{Binding DataContext.StatusPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=sound}">
                <TextBlock Text="밝기·소리" Style="{StaticResource Head}"/>
                <DockPanel>
                    <TextBlock Text="{StaticResource Icon.Volume2}" Style="{StaticResource Icon}" Width="30"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Volume}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding Volume}" local:Nav.InitialFocus="True"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="{StaticResource Icon.Sun}" Style="{StaticResource Icon}" Width="30"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Brightness}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="100" SmallChange="5" Value="{Binding Brightness}"/>
                </DockPanel>
                <Button Style="{StaticResource Link}" Command="{Binding DataContext.OpenWindowsPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="sound">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="출력 장치 고르기 (Windows 설정)"/></DockPanel>
                </Button>
            </StackPanel>

            <!-- 배터리 -->
            <StackPanel DataContext="{Binding QuickAccess}"
                        Visibility="{Binding DataContext.StatusPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=battery}">
                <TextBlock Text="{Binding BatteryText}" Style="{StaticResource Head}"/>
                <DockPanel Style="{StaticResource Row}"><TextBlock Text="{Binding RemainingText}" Style="{StaticResource RowValue}"/><TextBlock Text="남은 시간" Style="{StaticResource RowLabel}"/></DockPanel>
                <DockPanel Style="{StaticResource Row}"><TextBlock Text="{Binding PowerText}" Style="{StaticResource RowValue}"/><TextBlock Text="지금 소모" Style="{StaticResource RowLabel}"/></DockPanel>
                <DockPanel Style="{StaticResource Row}" Visibility="{Binding Power.HasHealth, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Power.HealthPercentText}" Style="{StaticResource RowValue}"/><TextBlock Text="배터리 수명" Style="{StaticResource RowLabel}"/>
                </DockPanel>
                <TextBlock Text="충전 한도" Style="{StaticResource Caption}" Margin="0,6,0,6"/>
                <WrapPanel IsEnabled="{Binding ChargeLimitAvailable}">
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="flimit" Content="100%" IsChecked="{Binding Limit100}" local:Nav.InitialFocus="True"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="flimit" Content="80%" IsChecked="{Binding Limit80}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="flimit" Content="60%" IsChecked="{Binding Limit60}"/>
                </WrapPanel>
                <Button Style="{StaticResource Link}" Command="{Binding DataContext.OpenSettingsAtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="battery">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="배터리·절전 설정 더 보기"/></DockPanel>
                </Button>
            </StackPanel>

            <!-- 날짜·시간 -->
            <StackPanel Visibility="{Binding StatusPanel, Converter={x:Static local:EqualsToVisibility.Instance}, ConverterParameter=clock}">
                <TextBlock FontSize="40" FontWeight="Bold">
                    <Run Text="{Binding PanelClock, Mode=OneWay}"/><Run Text="{Binding PanelSeconds, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}"/>
                </TextBlock>
                <TextBlock Text="{Binding DateText}" FontSize="17" Margin="0,2,0,6"/>
                <TextBlock Text="{Binding UptimeText}" Style="{StaticResource Caption}"/>
                <Button Style="{StaticResource Link}" Command="{Binding OpenWindowsPageCommand}" CommandParameter="dateandtime" Margin="0,12,0,0"
                        local:Nav.InitialFocus="True">
                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{StaticResource Icon.ChevronRight}" Style="{StaticResource Icon}" FontSize="16"/><TextBlock Text="날짜 및 시간 설정 (Windows)"/></DockPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
