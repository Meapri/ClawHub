<Application
    x:Class="ClawWidget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 2 = Windows 11 컨트롤 스타일 (둥근 모서리, Fluent 색) -->
                <muxc:XamlControlsResources ControlsResourcesVersion="Version2" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 위젯 전용 색. WinUI 리소스 키에 의존하지 않도록 직접 정의 (Windows 11 팔레트 근사값). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="WidgetCardBrush" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="WidgetCardStrokeBrush" Color="#19FFFFFF" />
                    <SolidColorBrush x:Key="WidgetSecondaryTextBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="WidgetTertiaryTextBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="WidgetOkBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="WidgetWarnBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="WidgetErrorBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="WidgetErrorBackgroundBrush" Color="#442726" />
                    <SolidColorBrush x:Key="WidgetToastBrush" Color="#F02C2C2C" />
                    <SolidColorBrush x:Key="WidgetHudPillBrush" Color="#D9202020" />
                    <SolidColorBrush x:Key="WidgetCpuLineBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="WidgetCpuFillBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.18" />
                    <SolidColorBrush x:Key="WidgetBatteryLineBrush" Color="#6CCB5F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="WidgetCardBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="WidgetCardStrokeBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="WidgetSecondaryTextBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="WidgetTertiaryTextBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="WidgetOkBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="WidgetWarnBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="WidgetErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="WidgetErrorBackgroundBrush" Color="#FDE7E9" />
                    <SolidColorBrush x:Key="WidgetToastBrush" Color="#F7FBFBFB" />
                    <SolidColorBrush x:Key="WidgetHudPillBrush" Color="#E6F9F9F9" />
                    <SolidColorBrush x:Key="WidgetCpuLineBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="WidgetCpuFillBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.14" />
                    <SolidColorBrush x:Key="WidgetBatteryLineBrush" Color="#0F7B0F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Lucide 아이콘 글꼴 (ISC). 코드포인트는 UI/Icons.cs 참고. -->
            <FontFamily x:Key="WidgetIconFont">ms-appx:///Assets/Fonts/lucide.ttf#lucide</FontFamily>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource WidgetSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource WidgetSecondaryTextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WidgetCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WidgetCardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="ChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="4,4" />
                <Setter Property="Margin" Value="2" />
            </Style>
            <Style x:Key="ChoiceButtonSelectedStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="4,4" />
                <Setter Property="Margin" Value="2" />
            </Style>
            <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,4" />
            </Style>
            <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="8,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
