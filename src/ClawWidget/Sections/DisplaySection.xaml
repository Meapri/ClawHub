<local:WidgetSection
    x:Class="ClawWidget.Sections.DisplaySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClawWidget.Sections"
    xmlns:ui="using:ClawWidget.UI">

    <!-- 화면 · 배터리: 밝기 + 충전 한도 -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="6">
            <ui:SectionHeader Icon="&#xE11D;" Title="화면 · 소리 · 배터리" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE178;" FontSize="16"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                        SmallChange="5" LargeChange="10" IsFocusEngagementEnabled="True"
                        VerticalAlignment="Center" ValueChanged="BrightnessSlider_ValueChanged"
                        AutomationProperties.Name="화면 밝기" />
                <TextBlock x:Name="BrightnessText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12" Text="–" />
            </Grid>
            <!-- 볼륨: 위젯은 직접 못 바꿔서 ClawHub 앱이 대신 바꾼다 (앱이 꺼져 있으면 비활성) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="VolumeIcon" FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE1AB;" FontSize="16"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                        SmallChange="5" LargeChange="10" IsFocusEngagementEnabled="True" IsEnabled="False"
                        VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                        AutomationProperties.Name="볼륨" />
                <TextBlock x:Name="VolumeText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12" Text="–" />
            </Grid>
            <Grid Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE053;" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="충전 한도" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ChargeDetail" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="" />
            </Grid>
            <Grid x:Name="ChargeGrid" Margin="-2,0" />
            <StackPanel x:Name="HealthRow" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" Visibility="Collapsed">
                <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE36E;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="HealthText" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</local:WidgetSection>
