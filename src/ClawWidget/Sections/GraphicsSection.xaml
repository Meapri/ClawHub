<local:WidgetSection
    x:Class="ClawWidget.Sections.GraphicsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClawWidget.Sections"
    xmlns:ui="using:ClawWidget.UI">

    <!-- 그래픽: FPS 제한 + XeSS 프레임 생성 (Intel 드라이버 기능이 있을 때만) -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="6">
            <ui:SectionHeader Icon="&#xE485;" Title="그래픽" />
            <Grid>
                <TextBlock Text="FPS 제한" Style="{StaticResource CaptionStyle}" />
                <TextBlock x:Name="FpsDetail" HorizontalAlignment="Right" Style="{StaticResource CaptionStyle}" Text="" />
            </Grid>
            <Grid x:Name="FpsGrid" Margin="-2,0" />
            <TextBlock Text="프레임 생성 (XeSS)" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
            <Grid x:Name="FrameGenGrid" Margin="-2,0" />
        </StackPanel>
    </Border>
</local:WidgetSection>
