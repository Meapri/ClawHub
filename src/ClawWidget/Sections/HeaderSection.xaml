<local:WidgetSection
    x:Class="ClawWidget.Sections.HeaderSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClawWidget.Sections">

    <!-- 머리: 실행 중 게임 · 연결 상태 · 매핑 프로필 · ClawHub 열기 · 게임 종료 -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE0DF;" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GameTitle" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Text="연결 중…" />
                    <TextBlock x:Name="GameSubtitle" Style="{StaticResource CaptionStyle}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="" />
                </StackPanel>
                <Ellipse x:Name="ConnDot" Grid.Column="2" Width="8" Height="8" VerticalAlignment="Top" Margin="8,6,0,0"
                         Fill="{ThemeResource WidgetTertiaryTextBrush}" />
            </Grid>

            <Button x:Name="ProfileButton" Style="{StaticResource ChipButtonStyle}" IsEnabled="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE284;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="키 매핑 " Foreground="{ThemeResource WidgetSecondaryTextBrush}" />
                        <TextBlock x:Name="ProfileText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="–" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE06D;" FontSize="12"
                              VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:Name="ProfileFlyout" Placement="Bottom" Opening="ProfileFlyout_Opening" />
                </Button.Flyout>
            </Button>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenAppButton" Style="{StaticResource ActionButtonStyle}" Click="OpenAppButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE0B9;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="ClawHub 열기" />
                    </StackPanel>
                </Button>
                <Button x:Name="QuitButton" Grid.Column="1" Style="{StaticResource ActionButtonStyle}" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE140;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="게임 종료" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="QuitFlyout" Placement="Bottom">
                            <StackPanel Spacing="12" MaxWidth="260">
                                <TextBlock x:Name="QuitQuestion" FontWeight="SemiBold" TextWrapping="Wrap" Text="게임을 종료할까요?" />
                                <TextBlock Style="{StaticResource CaptionStyle}" Text="저장하지 않은 진행 상황은 사라질 수 있어요." />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource MetroAccentButtonStyle}" HorizontalAlignment="Stretch"
                                            Content="종료" Click="QuitConfirmButton_Click" />
                                    <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Content="취소" Click="QuitCancelButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</local:WidgetSection>
