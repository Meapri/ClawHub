<local:WidgetSection
    x:Class="ClawWidget.Sections.PerformanceSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClawWidget.Sections"
    xmlns:ui="using:ClawWidget.UI">

    <!-- 성능: (충전 중/배터리 칸 선택) + 절전/균형/성능/수동 + 수동 PL 슬라이더 + 쿨러 부스트 + 배터리용 따로 설정 -->
    <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
            <ui:SectionHeader x:Name="Header" Icon="&#xE1BF;" Title="성능" />

            <!-- 배터리용 따로 설정이 켜져 있을 때만: 아래 타일이 어느 칸을 바꿀지 -->
            <StackPanel x:Name="TargetPanel" Visibility="Collapsed" Spacing="2">
                <TextBlock Text="편집할 설정" Style="{StaticResource CaptionStyle}" />
                <Grid x:Name="TargetGrid" Margin="-2,0" />
            </StackPanel>

            <Grid x:Name="ModeGrid" Margin="-2,0" />

            <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Spacing="2">
                <Grid>
                    <TextBlock Text="PL1 · 지속 전력" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="Pl1Text" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Text="" />
                </Grid>
                <Slider x:Name="Pl1Slider" Minimum="8" Maximum="45" StepFrequency="1" SmallChange="1" LargeChange="5"
                        IsFocusEngagementEnabled="True" ValueChanged="PlSlider_ValueChanged"
                        AutomationProperties.Name="PL1 지속 전력" />
                <Grid>
                    <TextBlock Text="PL2 · 순간 전력" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="Pl2Text" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Text="" />
                </Grid>
                <Slider x:Name="Pl2Slider" Minimum="8" Maximum="45" StepFrequency="1" SmallChange="1" LargeChange="5"
                        IsFocusEngagementEnabled="True" ValueChanged="PlSlider_ValueChanged"
                        AutomationProperties.Name="PL2 순간 전력" />
            </StackPanel>

            <TextBlock x:Name="PerfNote" Visibility="Collapsed" Style="{StaticResource CaptionStyle}" />

            <Rectangle Height="1" Margin="0,2" Fill="{ThemeResource WidgetCardStrokeBrush}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE165;" FontSize="16"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="쿨러 부스트" />
                    <TextBlock Text="팬을 최대 속도로" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <ToggleSwitch x:Name="CoolerToggle" Grid.Column="2" MinWidth="0" Margin="8,0,-12,0"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              OnContent="켬" OffContent="끔" Toggled="CoolerToggle_Toggled" />
            </Grid>

            <Grid x:Name="SeparateRow" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE053;" FontSize="16"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="배터리용 따로 설정" />
                    <TextBlock x:Name="SeparateCaption" Text="끄면 배터리에서도 같은 설정을 써요" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
                <ToggleSwitch x:Name="SeparateToggle" Grid.Column="2" MinWidth="0" Margin="8,0,-12,0"
                              VerticalAlignment="Center" HorizontalAlignment="Right"
                              OnContent="켬" OffContent="끔" Toggled="SeparateToggle_Toggled" />
            </Grid>
        </StackPanel>
    </Border>
</local:WidgetSection>
