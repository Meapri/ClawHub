<Page
    x:Class="ClawWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled"
    NavigationCacheMode="Disabled">

    <!-- 패드: Game Bar가 위젯에 포커스를 주면 D-pad/스틱 = XY 포커스 이동, A = 누르기, B = 플라이아웃 닫기.
         슬라이더는 IsFocusEngagementEnabled — A로 잡고 좌우로 조절, B로 놓기 (Xbox 표준). LB/RB는 Game Bar 몫.
         카드(섹션)는 코드에서 SectionsPanel에 넣는다 — WidgetPage.CreateSections(). -->
    <Grid x:Name="RootGrid" Background="{ThemeResource WidgetBackgroundBrush}">

        <!-- ═════════════ 전체 화면 ═════════════ -->
        <ScrollViewer x:Name="FullView"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsTabStop="False">
            <StackPanel x:Name="MainStack" Padding="12,10,12,12">

                <!-- 서비스 연결 안 됨 -->
                <Border x:Name="OfflineCard" Visibility="Collapsed" Padding="12" Margin="0,0,0,6"
                        Background="{ThemeResource WidgetErrorBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE193;" FontSize="16"
                                  VerticalAlignment="Top" Margin="0,2,10,0" Foreground="{ThemeResource WidgetErrorBrush}" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="서비스 연결 안 됨" FontWeight="SemiBold" />
                            <TextBlock x:Name="OfflineDetail" Style="{StaticResource CaptionStyle}" Text="ClawHub 서비스에 연결할 수 없어요" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="자동으로 계속 다시 연결해요." />
                            <Button x:Name="RetryButton" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="RetryButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE145;" FontSize="14" />
                                    <TextBlock Text="지금 다시 연결" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="SectionsPanel">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>
                </StackPanel>

                <TextBlock x:Name="WarningText" Visibility="Collapsed" Margin="4,0,4,4" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════════ 고정(핀) 미니 HUD — Game Bar가 닫혀 있고 위젯만 게임 위에 떠 있을 때 ═════════════ -->
        <Border x:Name="PinnedView" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                Padding="10,6" Background="{ThemeResource WidgetHudPillBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE0A9;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource WidgetCpuLineBrush}" />
                <TextBlock x:Name="HudCpuTemp" FontWeight="SemiBold" VerticalAlignment="Center" Text="–" />
                <TextBlock Text="·" VerticalAlignment="Center" Foreground="{ThemeResource WidgetTertiaryTextBrush}" />
                <TextBlock x:Name="HudCpuWatts" FontWeight="SemiBold" VerticalAlignment="Center" Text="–" />
                <Rectangle Width="1" Height="14" Margin="4,0" VerticalAlignment="Center" Fill="{ThemeResource WidgetCardStrokeBrush}" />
                <FontIcon x:Name="HudBatteryIcon" FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE053;" FontSize="14"
                          VerticalAlignment="Center" Foreground="{ThemeResource WidgetBatteryLineBrush}" />
                <TextBlock x:Name="HudBattery" FontWeight="SemiBold" VerticalAlignment="Center" Text="–" />
                <TextBlock x:Name="HudBatteryWatts" VerticalAlignment="Center" Foreground="{ThemeResource WidgetSecondaryTextBrush}" Text="" />
            </StackPanel>
        </Border>

        <!-- ═════════════ 알림 (명령 실패 등, 잠깐 표시) ═════════════ -->
        <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Margin="12" Padding="12,10" IsHitTestVisible="False"
                Background="{ThemeResource WidgetToastBrush}" BorderThickness="1" BorderBrush="{ThemeResource WidgetCardStrokeBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="ToastIcon" FontFamily="{StaticResource WidgetIconFont}" Glyph="&#xE077;" FontSize="14"
                          VerticalAlignment="Top" Margin="0,2,10,0" Foreground="{ThemeResource WidgetErrorBrush}" />
                <TextBlock x:Name="ToastText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" />
            </Grid>
        </Border>
    </Grid>
</Page>
